{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ws.meriler.cc/content/schema/lesson.schema.json",
 "title": "Манифест занятия — фаза 0 (нормативная схема, финализирована 2026-07-17)",
 "description": "Источник семантики: ТЗ-демка-з1 §3 + аннекс ТЗ-демка-з1-схема-манифеста (vault). Реестр типов шагов ЗАКРЫТ: новый type = правка спеки, не рефлекс (риск 3 ТЗ).",
 "type": "object",
 "required": [
  "manifest_schema_version",
  "lesson"
 ],
 "additionalProperties": false,
 "properties": {
  "manifest_schema_version": {
   "const": 1
  },
  "lesson": {
   "type": "object",
   "required": [
    "id",
    "title",
    "duration_min",
    "bank",
    "steps",
    "reserve_steps",
    "hints",
    "ui_texts"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
     "type": "string"
    },
    "duration_min": {
     "type": "integer",
     "minimum": 1,
     "maximum": 180
    },
    "bank": {
     "type": "string",
     "description": "id банка (bank.json рядом)"
    },
    "engine": {
     "type": "string",
     "enum": [
      "knn",
      "head"
     ],
     "description": "движок занятия (ТЗ-платформа-v3 §2.2), дефолт knn; валидатор пускает только движки, пилотированные на банке (frozen_params.engines + knn). Переключение прод-занятия = правка этой строки"
    },
    "steps": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/step"
     }
    },
    "reserve_steps": {
     "type": "array",
     "minItems": 2,
     "items": {
      "$ref": "#/$defs/reserveStep"
     },
     "description": "Правило 12 плана: ровно два резерва — kind=talk И kind=trainer (взаимоналичие проверяет валидатор)"
    },
    "hints": {
     "type": "object",
     "description": "ключ = '<stepId>.<phaseId>'",
     "additionalProperties": {
      "$ref": "#/$defs/hint"
     }
    },
    "ui_texts": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/childText"
     }
    }
   }
  }
 },
 "$defs": {
  "childText": {
   "type": "string",
   "maxLength": 120,
   "description": "Детский текст: ≤120 симв = ≤2 строки (конституция, счётно)"
  },
  "overlayId": {
   "enum": [
    "buffer",
    "reaction",
    "chat"
   ],
   "description": "Реестр оверлеев ЗАКРЫТ. «Застрял» — НЕ оверлей (всегда виден, вне лимита ≤5); «шаг N из M» — индикатор, не интерактив"
  },
  "elementId": {
   "type": "string",
   "pattern": "^(img_current|btn_next|btn_undo|btn_train|btn_check|btn_commit|btn_skip|btn_pick|btn_relayout|free_text|basket_[a-z0-9_-]+|frag[1-9]|opt[1-9])$",
   "description": "Грамматика id ЗАКРЫТА (btn_relayout добавлен осознанным расширением фазы 0.5: «разложить заново» на такте «Научить» — валидатор требует такт с корзинами в том же шаге). Параметризованные: basket_<classId> (classId из bank.classes), frag<n> (фрагмент n слота такта — такт обязан нести slot), opt<n> (вариант n version.choice.options). Ссылочную целостность проверяет валидатор"
  },
  "phase": {
   "type": "object",
   "required": [
    "id",
    "elements",
    "overlays"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "text": {
     "$ref": "#/$defs/childText"
    },
    "slot": {
     "type": "integer",
     "minimum": 1,
     "description": "Номер слота version.template для тактов с frag<n>"
    },
    "probe_set": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     },
     "description": "id картинок роли control из банка (один контрольный набор — проба акта 1 и замер акта 2)"
    },
    "microcycle_reaction": {
     "type": "boolean"
    },
    "elements": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "$ref": "#/$defs/elementId"
     }
    },
    "overlays": {
     "type": "array",
     "maxItems": 3,
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/overlayId"
     }
    }
   },
   "description": "Такт. Лимит len(elements)+len(overlays) ≤ 5 проверяет валидатор (JSON Schema не умеет сумму)"
  },
  "gateSpec": {
   "type": "object",
   "required": [
    "kind"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "enum": [
      "code",
      "checkin"
     ]
    }
   }
  },
  "stepCommon": {
   "type": "object",
   "required": [
    "id",
    "type",
    "catchup"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "type": {
     "enum": [
      "gate",
      "slide",
      "cards_quiz",
      "trainer_act",
      "talk_chat",
      "final_card"
     ]
    },
    "timebox_min": {
     "type": "number",
     "minimum": 0.5,
     "description": "Данные, не код: правится после репетиции"
    },
    "catchup": {
     "$ref": "#/$defs/childText",
     "description": "Карточка догоняющему — обязательна у КАЖДОГО шага (§1.1)"
    },
    "gate": {
     "$ref": "#/$defs/gateSpec",
     "description": "Входной гейт шага (допустим у любого типа, напр. trainer_act s6)"
    },
    "phases": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/phase"
     }
    },
    "elements": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "$ref": "#/$defs/elementId"
     },
     "description": "ЗАПРЕЩЕНО схемой у всех типов (аудит 18.07, п.12): сахар одного такта отменял derived-формулы; оставлено в stepCommon только как словарь имён"
    },
    "overlays": {
     "type": "array",
     "maxItems": 3,
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/overlayId"
     }
    }
   }
  },
  "quizCard": {
   "type": "object",
   "required": [
    "id",
    "img",
    "title"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "img": {
     "type": "string",
     "description": "путь в assets/ — существование проверяет валидатор"
    },
    "title": {
     "$ref": "#/$defs/childText"
    },
    "options": {
     "type": "array",
     "minItems": 2,
     "maxItems": 4,
     "items": {
      "$ref": "#/$defs/childText"
     },
     "description": "≤4: на отвеченной карточке появляется «Дальше» — 4 варианта + Дальше = 5, лимит держится"
    },
    "correct": {
     "description": "int для одиночного выбора, int[] для multi"
    },
    "multi": {
     "type": "boolean"
    },
    "explain": {
     "$ref": "#/$defs/childText",
     "description": "одна фраза-объяснение после выбора (разговорный резерв kind=talk, И4-Т F)"
    },
    "cells": {
     "type": "integer",
     "minimum": 2,
     "maximum": 4,
     "description": "Сетка multi-карточки. >4 ячеек ломает лимит ≤5 (cells+коммит) — только осознанным исключением владельца, валидатор даёт warning"
    }
   },
   "oneOf": [
    {
     "required": [
      "options",
      "correct"
     ],
     "not": {
      "required": [
       "multi"
      ]
     }
    },
    {
     "required": [
      "multi",
      "cells",
      "correct"
     ],
     "properties": {
      "multi": {
       "const": true
      }
     }
    }
   ]
  },
  "versionSpec": {
   "type": "object",
   "required": [
    "template",
    "choice",
    "reveal_lock"
   ],
   "additionalProperties": false,
   "properties": {
    "template": {
     "type": "object",
     "required": [
      "lead",
      "slots"
     ],
     "additionalProperties": false,
     "properties": {
      "lead": {
       "$ref": "#/$defs/childText"
      },
      "slots": {
       "type": "array",
       "minItems": 1,
       "maxItems": 3,
       "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 5,
        "items": {
         "$ref": "#/$defs/childText"
        }
       }
      },
      "free_text": {
       "type": "boolean"
      }
     }
    },
    "choice": {
     "type": "object",
     "required": [
      "options",
      "correct"
     ],
     "additionalProperties": false,
     "properties": {
      "options": {
       "type": "array",
       "minItems": 3,
       "maxItems": 4,
       "items": {
        "$ref": "#/$defs/childText"
       }
      },
      "correct": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "reveal_lock": {
     "type": "boolean"
    }
   }
  },
  "revealSpec": {
   "type": "object",
   "required": [
    "cards",
    "text"
   ],
   "additionalProperties": false,
   "properties": {
    "cards": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    },
    "text": {
     "$ref": "#/$defs/childText"
    },
    "show_anon_versions": {
     "type": "boolean"
    }
   }
  },
  "measureSpec": {
   "type": "object",
   "required": [
    "holdout",
    "pass",
    "before",
    "after"
   ],
   "additionalProperties": false,
   "properties": {
    "holdout": {
     "type": "array",
     "minItems": 4,
     "items": {
      "type": "string"
     }
    },
    "pass": {
     "type": "string",
     "pattern": "^[0-9]+/[0-9]+$"
    },
    "residual_talk": {
     "type": "string",
     "description": "Разговорная строка на экране замера, когда замер ПРОШЁЛ (score ≥ pass), но НЕ идеален (score < of): остаточную ошибку модели ведущий разбирает голосом. Подача — «открытие, а не упрёк»: признать победу, нормализовать остаток («так бывает даже у настоящего ИИ»), позвать в любопытство («почему именно эту?»); дефицит («не 4 из 4») не поминать — числа уже видны в счёте. Опциональные плейсхолдеры {score}/{of} подставляет движок. Не показывается при идеале (score == of). Методический момент «ИИ не идеален» — решение владельца, откат порога 3/4"
    },
    "before": {
     "enum": [
      "auto",
      "from_probe"
     ],
     "description": "auto — авто-замер модели при входе в шаг (резерв-добор); from_probe — «до починки» берётся из пробы акта 1 на том же контрольном наборе (И4-Т: замер по кнопке, не авто)"
    },
    "after": {
     "enum": [
      "on_retrain"
     ]
    }
   }
  },
  "forecastSpec": {
   "type": "object",
   "required": [
    "img",
    "predict_options",
    "reason_options",
    "expected"
   ],
   "additionalProperties": false,
   "properties": {
    "img": {
     "type": "string"
    },
    "predict_options": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "$ref": "#/$defs/childText"
     }
    },
    "reason_options": {
     "type": "array",
     "minItems": 3,
     "maxItems": 3,
     "items": {
      "$ref": "#/$defs/childText"
     }
    },
    "expected": {
     "type": "object",
     "required": [
      "predict",
      "reason"
     ],
     "additionalProperties": false,
     "properties": {
      "predict": {
       "type": "integer"
      },
      "reason": {
       "type": "integer"
      }
     }
    }
   }
  },
  "hint": {
   "type": "object",
   "required": [
    "l1",
    "l2",
    "restore_to"
   ],
   "additionalProperties": false,
   "properties": {
    "l1": {
     "$ref": "#/$defs/childText"
    },
    "l2": {
     "$ref": "#/$defs/childText"
    },
    "restore_to": {
     "type": "string",
     "description": "'<stepId>.<phaseId>' — контрольная точка восстановления (уровень 3)"
    }
   }
  },
  "step": {
   "allOf": [
    {
     "$ref": "#/$defs/stepBody"
    }
   ],
   "unevaluatedProperties": false,
   "description": "Шаг занятия. unevaluatedProperties: false — неизвестные/опечатанные поля (аудит ядра 18.07, п.13) отклоняются схемой"
  },
  "reserveStep": {
   "allOf": [
    {
     "$ref": "#/$defs/stepBody"
    },
    {
     "type": "object",
     "required": [
      "kind",
      "title"
     ],
     "properties": {
      "kind": {
       "enum": [
        "talk",
        "trainer"
       ]
      },
      "title": {
       "type": "string"
      },
      "talk_note": {
       "$ref": "#/$defs/childText",
       "description": "строка «Обсуди с ведущим, почему» под ответом разговорного резерва (И4-Т F)"
      }
     }
    }
   ],
   "unevaluatedProperties": false,
   "description": "Резервный шаг: тело шага + kind/title/talk_note; замок свой (оценены веткой рядом)"
  },
  "stepBody": {
   "allOf": [
    {
     "$ref": "#/$defs/stepCommon"
    },
    {
     "oneOf": [
      {
       "properties": {
        "type": {
         "const": "gate"
        },
        "gate": {
         "$ref": "#/$defs/gateSpec"
        },
        "phases": false,
        "elements": false,
        "overlays": false
       },
       "required": [
        "gate"
       ],
       "description": "такты derived-типа задаёт формула аннекса §1.4 — ручные phases/elements/overlays отменяли бы штатное разворачивание (аудит ядра 18.07, п.12)"
      },
      {
       "properties": {
        "type": {
         "const": "slide"
        },
        "title": {
         "$ref": "#/$defs/childText"
        },
        "text": {
         "$ref": "#/$defs/childText"
        },
        "img": {
         "type": "string",
         "description": "путь в assets/ — существование проверяет валидатор; стилизацию (пример капчи) несёт сам ассет"
        },
        "caption": {
         "$ref": "#/$defs/childText"
        },
        "phases": false,
        "elements": false,
        "overlays": false
       },
       "required": [
        "type"
       ],
       "anyOf": [
        {
         "required": [
          "img"
         ]
        },
        {
         "required": [
          "text"
         ]
        }
       ],
       "description": "Слайд «для поговорить» (осознанное расширение реестра, фаза 0.5): title/text/img/caption + одна кнопка «Дальше». Пустой слайд (без img и text) запрещён; такты derived-типа задаёт формула аннекса §1.4 — ручные phases/elements/overlays отменяли бы штатное разворачивание (аудит ядра 18.07, п.12)"
      },
      {
       "properties": {
        "type": {
         "const": "cards_quiz"
        },
        "cards": {
         "type": "array",
         "minItems": 1,
         "items": {
          "$ref": "#/$defs/quizCard"
         }
        },
        "private_commit": {
         "type": "boolean"
        },
        "reveal_text": {
         "$ref": "#/$defs/childText"
        },
        "phases": false,
        "elements": false,
        "overlays": false
       },
       "required": [
        "cards"
       ],
       "description": "такты derived-типа задаёт формула аннекса §1.4 — ручные phases/elements/overlays отменяли бы штатное разворачивание (аудит ядра 18.07, п.12)"
      },
      {
       "properties": {
        "type": {
         "const": "trainer_act"
        },
        "mode": {
         "enum": [
          "rails",
          "fix",
          "boost"
         ]
        },
        "version": {
         "$ref": "#/$defs/versionSpec"
        },
        "reveal": {
         "$ref": "#/$defs/revealSpec"
        },
        "traps_from_bank": {
         "type": "boolean"
        },
        "images_from_role": {
         "enum": [
          "reserve"
         ]
        },
        "measure": {
         "$ref": "#/$defs/measureSpec"
        },
        "forecast": {
         "$ref": "#/$defs/forecastSpec"
        },
        "elements": false,
        "overlays": false
       },
       "required": [
        "mode",
        "phases"
       ],
       "description": "сахар elements/overlays верхнего уровня запрещён: trainer_act всегда несёт явные phases"
      },
      {
       "properties": {
        "type": {
         "const": "talk_chat"
        },
        "prompt": {
         "type": "string",
         "maxLength": 200
        },
        "think_sec": {
         "type": "integer",
         "minimum": 10,
         "maximum": 120
        },
        "phases": false,
        "elements": false,
        "overlays": false
       },
       "required": [
        "prompt",
        "think_sec"
       ],
       "description": "такты derived-типа задаёт формула аннекса §1.4 — ручные phases/elements/overlays отменяли бы штатное разворачивание (аудит ядра 18.07, п.12)"
      },
      {
       "properties": {
        "type": {
         "const": "final_card"
        },
        "action": {
         "enum": [
          "mark_best_trap"
         ]
        },
        "presentation": {
         "enum": [
          "one_by_one"
         ],
         "description": "Обязателен при рантайм-множестве кандидатов — требует валидатор (§1.2)"
        },
        "next_block": {
         "type": "object",
         "required": [
          "cards"
         ],
         "additionalProperties": false,
         "properties": {
          "cards": {
           "type": "array",
           "items": {
            "type": "string"
           }
          },
          "captions": {
           "type": "array",
           "items": {
            "$ref": "#/$defs/childText"
           },
           "description": "подписи к карточкам «Что дальше» — по индексу (план-правок п.6)"
          },
          "cases": {
           "type": "array",
           "minItems": 2,
           "items": {
            "$ref": "#/$defs/childText"
           },
           "description": "Путь детектива (И3-Т п.7): плашки дел курса — первая «✓» (текущее занятие), остальные серые с замком; данные, не код"
          }
         }
        },
        "phases": false,
        "elements": false,
        "overlays": false
       },
       "required": [
        "action"
       ],
       "description": "такты derived-типа задаёт формула аннекса §1.4 — ручные phases/elements/overlays отменяли бы штатное разворачивание (аудит ядра 18.07, п.12)"
      }
     ]
    }
   ],
   "description": "Тело шага (stepCommon + ветка типа) БЕЗ замка unevaluatedProperties — замок вешают step и reserveStep, каждый на своём наборе полей"
  }
 }
}
