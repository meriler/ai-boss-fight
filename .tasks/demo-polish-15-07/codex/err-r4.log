   539	function srcRect(){ const vw=cam.videoWidth||640, vh=cam.videoHeight||480, s=Math.min(vw,vh); return [(vw-s)/2,(vh-s)/2,s,s]; }
   540	function grabFeature(){
   541	  if(DEMO){ drawDemoFrame(); }
   542	  const [sx,sy,sw,sh]=DEMO?[0,0,demoCv.width,demoCv.height]:srcRect();
   543	  const src=DEMO?demoCv:cam;
   544	  // image-эмбеддинг (центральный квадрат → 224)
   545	  fx.drawImage(src,sx,sy,sw,sh,0,0,224,224);
   546	  let e=null;
   547	  try{ const r=embedder.embed(fcv); e=r.embeddings[0].floatEmbedding; }
   548	  catch(err){ const now=Date.now(); if(!window.__ef||now-window.__ef>10000){window.__ef=now;TELE.push('embed_fail');} return null; }
   549	  let ne=0; for(let i=0;i<e.length;i++)ne+=e[i]*e[i]; ne=Math.sqrt(ne)||1;
   550	  const emb=new Float32Array(e.length); for(let i=0;i<e.length;i++)emb[i]=e[i]/ne;
