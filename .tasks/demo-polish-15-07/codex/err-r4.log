   657	    try{s=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'user'},width:{ideal:640},frameRate:{ideal:24,max:30}},audio:false})}
   658	    catch(e){ try{s=await navigator.mediaDevices.getUserMedia({video:true,audio:false})}catch(e2){throw new Error('CAM:'+e2.name)} }
   659	    cam.srcObject=s;await new Promise(r=>cam.onloadedmetadata=r);await cam.play().catch(()=>{});
