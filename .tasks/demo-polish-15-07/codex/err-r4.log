   661	    // cam_drop от этого же обрыва (аудит Codex 10.07); сбрасывает latch ватчдог/камера-ретрай
   662	    s.getVideoTracks()[0].addEventListener('ended',()=>{if(!camWasDown){camWasDown=true;TELE.push('cam_drop',{auto:true});}hintEl.textContent='📷 камера отпала, перезапускаю…';initCamera().catch(()=>{})});
