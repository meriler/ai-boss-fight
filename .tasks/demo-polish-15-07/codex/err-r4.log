   535	/* ---- захват признаков из кадра: image-эмбеддинг + сырые пиксели 32×32 ---- */
   536	const fcv=document.createElement('canvas'); fcv.width=224; fcv.height=224; const fx=fcv.getContext('2d');
   537	const pcv=document.createElement('canvas'); pcv.width=32;  pcv.height=32;  const pxc=pcv.getContext('2d',{willReadFrequently:true});
