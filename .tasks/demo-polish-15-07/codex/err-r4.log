  1116	    return recs;
  1117	  }
  1118	  const mn=Math.min(counts[0],counts[1]),mx=Math.max(counts[0],counts[1]);
  1119	  if(mx>=mn*2+2){const less=counts[0]<counts[1]?0:1;recs.push(`Перекос: ${CLASSES[0].emoji} ${counts[0]} · ${CLASSES[1].emoji} ${counts[1]}. Добери ${CLASSES[less].emoji}.`);}
  1120	  for(let c=0;c<2;c++){ if(pc[c].confused>=2)recs.push(`ИИ путал ${CLASSES[c].emoji} ${CLASSES[c].name} с ${CLASSES[1-c].emoji}. Добери ${CLASSES[c].emoji} в разных местах и с разным фоном.`); }
