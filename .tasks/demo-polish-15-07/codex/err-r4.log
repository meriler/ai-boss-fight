  1125	function wrapLinesCanvas(x,text,maxW){
  1126	  const words=text.split(' '),lines=[];let cur='';
  1127	  for(const w of words){ const t=cur?cur+' '+w:w; if(x.measureText(t).width>maxW&&cur){lines.push(cur);cur=w;} else cur=t; }
  1128	  if(cur)lines.push(cur); return lines;
  1129	}
