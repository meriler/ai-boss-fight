  1352	function fixPick(o){
  1353	  const now=performance.now();               // дабл-тап не должен съесть обе попытки (ось «сам починил»)
  1354	  if(now-(fixPick._t||0)<400)return; fixPick._t=now;
  1355	  GUIDE.fixAttempts++;
  1356	  TELE.push('fix_choice',{attempt:GUIDE.fixAttempts,choice:o.key,correct:o.correct});
  1357	  if(o.correct){ GUIDE.fixChosen='self'; goFix(); return; }
  1358	  SFX.buzz();
  1359	  if(GUIDE.fixAttempts>=2){                    // после 2-й ошибки не запираем: показываем ход и чиним
  1360	    GUIDE.fixChosen='shown';
  1361	    $('#fixhint').innerHTML='Правильный ход — <b>наоборот</b>: маленькие ладони и большие кулаки. ИИ нужно увидеть то, чего НЕ БЫЛО в его примерах.';
  1362	    $('#fixhint').classList.remove('hidden');
  1363	    const btns=$('#fixbtns'); btns.innerHTML='';
  1364	    const b=document.createElement('button'); b.className='ok'; b.style.cssText='width:min(340px,74vw);flex:0 0 auto';
  1365	    b.textContent='🔧 Чинить'; b.onclick=goFix; btns.appendChild(b);
  1366	    return;
  1367	  }
  1368	  $('#fixhint').innerHTML='Вспомни разгадку: ВСЕ твои ладони были большими, а кулаки маленькими. Чего ИИ ещё ни разу не видел?';
  1369	  $('#fixhint').classList.remove('hidden');
