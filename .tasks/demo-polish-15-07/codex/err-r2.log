   105	  /* ===== guided-режим (урок) ===== */
   106	  #guide{position:absolute;left:50%;top:12px;transform:translateX(-50%);width:min(94vw,620px);text-align:center;z-index:14;pointer-events:none}
   107	  #gstep{font-size:12px;font-weight:800;letter-spacing:.6px;color:var(--muted);text-shadow:0 1px 3px #000;text-transform:uppercase}
   108	  #gtask{font-size:clamp(19px,5vw,28px);font-weight:900;text-shadow:0 3px 12px #000;margin-top:4px;line-height:1.25;background:rgba(8,11,18,.55);border-radius:16px;padding:10px 16px;backdrop-filter:blur(4px)}
   109	  #gtask .em{font-size:clamp(30px,8vw,44px);vertical-align:middle;margin-right:6px}
   110	  #gdots{display:flex;gap:7px;justify-content:center;margin-top:10px}
   111	  #gdots i{width:18px;height:18px;border-radius:50%;background:#0009;border:2px solid #6b7a90;transition:all .15s}
   112	  #gdots i.on{background:var(--ok);border-color:var(--ok);box-shadow:0 0 8px rgba(70,224,138,.8)}
   113	  #ggate{margin-top:8px;font-size:15px;font-weight:800;text-shadow:0 2px 6px #000;min-height:1.3em}
   114	  #ggate.ok{color:var(--ok)} #ggate.no{color:var(--warn)}
   115	  /* калибровка и потеря камеры — оверлеи по центру */
   116	  .midcard{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(90vw,520px);text-align:center;background:rgba(8,11,18,.82);border:1px solid var(--line);border-radius:20px;padding:22px 20px;backdrop-filter:blur(6px);z-index:16;display:flex;flex-direction:column;gap:12px;align-items:center}
   117	  .midcard .big{font-size:44px}
   118	  .midcard h2{margin:0;font-size:clamp(19px,5vw,26px);line-height:1.3}
   119	  .midcard p{margin:0;color:var(--muted);font-size:14px;line-height:1.45;max-width:420px}
   120	  .midcard button{width:min(360px,78vw);flex:0 0 auto}
   121	  /* экран-угадайка и разгадка */
   122	  /* варианты одинаковой высоты, крупный кегль — тексты короткие, взгляд не цепляется за длину (прогон 13.07, Настя) */
   123	  .choice{width:min(460px,86vw);text-align:left;background:#10151e;border:2px solid var(--line);border-radius:16px;padding:12px 16px;font-size:18px;font-weight:700;color:var(--text);min-height:58px;display:flex;align-items:center}
   124	  .choice:active{transform:scale(.98)}
   125	  #gal,#lockgal{display:flex;flex-direction:column;gap:10px;width:min(600px,94vw)}
   126	  .galrow{background:#10151e;border:1px solid var(--line);border-radius:14px;padding:12px 14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:center}
   127	  .galrow .gl{font-size:15px;font-weight:800;flex:0 0 100%;text-align:left}
   128	  .galrow canvas{width:84px;height:84px;border-radius:10px;image-rendering:pixelated;border:1px solid var(--line)}
   129	  .keyline{background:rgba(255,207,92,.12);border:1px solid var(--warn);border-radius:14px;padding:12px 16px;font-size:16px;font-weight:700;line-height:1.4;max-width:460px}
   130	  .oneliner{background:rgba(70,224,138,.1);border:1px solid var(--ok);border-radius:14px;padding:12px 16px;font-size:15px;font-weight:700;line-height:1.4;max-width:460px;color:var(--text)}
   131	  /* опрос */
   132	  #survey textarea{width:min(460px,88vw);min-height:96px;border-radius:14px;border:2px solid var(--line);background:#10151e;color:var(--text);font-size:16px;padding:12px;font-family:inherit;resize:none}
   133	  #survey textarea:focus{outline:none;border-color:var(--accent)}
   134	  #svq{font-size:clamp(18px,5vw,24px);font-weight:800;max-width:460px;line-height:1.35}
   135	  #svstep{font-size:13px;color:var(--muted)}
   136	  /* приватная гипотеза (ws): ввод замаскирован — экран ребёнка бывает на общей демонстрации */
   137	  #hypo textarea{width:100%;min-height:84px;border-radius:14px;border:2px solid var(--line);background:#10151e;color:var(--text);font-size:16px;padding:12px 56px 12px 12px;font-family:inherit;resize:none}
   138	  #hypo textarea:focus{outline:none;border-color:var(--accent)}
   139	  .masked{-webkit-text-security:disc}
   140	  #hypoEye{position:absolute;right:6px;top:6px;width:44px;height:44px;min-height:0;padding:0;border-radius:10px;background:rgba(40,50,64,.85);font-size:18px;flex:none}
   141	  /* замок разгадки (ws): код ведущего */
   142	  #lockcode{width:min(240px,60vw);border-radius:14px;border:2px solid var(--line);background:#10151e;color:var(--text);font-size:26px;font-weight:800;text-align:center;padding:12px;font-family:inherit;letter-spacing:6px}
   143	  #lockcode::placeholder{font-size:15px;letter-spacing:0;font-weight:600;color:var(--muted)}
   144	  #lockNext.dim{opacity:.45;filter:saturate(.4)}   /* до ввода кода кнопка не зазывает (дети тыкали пустую) */
   145	  #lockcode:focus{outline:none;border-color:var(--accent)}
   146	  /* ввод номера места */
   147	  /* колонки сжимаемые: фиксированные 64px вылезали за узкое окно/зум — терялись целые столбцы (смок 09.07) */
   148	  #seatgrid{display:grid;grid-template-columns:repeat(5,minmax(44px,64px));gap:8px;justify-content:center;width:100%;max-width:400px}
   149	  #seatgrid button{min-height:56px;padding:0;font-size:20px;border-radius:14px}
   150	  /* debug-панель */
   151	  /* бейдж «место · этап» (ws): техпомощь голосом без демонстрации экрана — ребёнок читает вслух */
   152	  #stagebadge{position:absolute;left:10px;top:10px;z-index:22;background:rgba(10,14,20,.78);border:1px solid var(--line);border-radius:10px;padding:4px 10px;font-size:12px;font-weight:700;color:var(--text);pointer-events:none}
   153	  /* pointer-events:none — приборка не должна воровать клики у кнопок под ней (ловил e2e 10.07) */
   154	  #debug{position:absolute;left:10px;bottom:10px;z-index:40;background:rgba(5,8,13,.88);border:1px solid var(--line);border-radius:12px;padding:10px 12px;font:12px/1.5 ui-monospace,Menlo,monospace;color:#9fe8bb;max-width:330px;white-space:pre-wrap;pointer-events:none}
   155	  #debug .dbtns button{pointer-events:auto}
   156	  #debug b{color:#fff}
   157	  #debug .dbtns{display:flex;gap:6px;margin-top:6px}
   158	  #debug button{min-height:30px;padding:4px 10px;font-size:12px;border-radius:8px;flex:0 0 auto}
   159	</style>
