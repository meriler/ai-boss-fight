  1287	  opts.forEach(o=>{ const b=document.createElement('button'); b.className='choice'; b.textContent=o.label;
  1288	    b.onclick=()=>{ TELE.push('guess',{choice:o.key,cat:o.cat,correct:o.key==='size'});   // пушится ОДИН раз
