  1064	/* ---- развилки урока после проверки ---- */
  1065	function finishGuidedCheck(correct,total){
  1066	  state='gpause'; topEl.classList.add('hidden');
  1067	  if(CHK.round===1){
  1068	    GUIDE.res1={correct,total};
  1069	    const probe=CHK.results[CHK.results.length-1];    // пробник ✋ ИЗДАЛЕКА — всегда последняя карточка R1
  1070	    if(probe.verdict==='nohand'){                     // редкость: невалидные замеры ловятся раньше
  1071	      TELE.push('inconclusive'); GUIDE.outcome='inconclusive'; showFinal(); return;
  1072	    }
  1073	    if(probe.verdict==='correct'){                    // ИИ не обманулся — редкий честный путь
  1074	      TELE.push('no_break'); GUIDE.outcome='no_break'; showFinal(); return;
  1075	    }
  1076	    TELE.push('break_shown',{verdict:probe.verdict,got:probe.got});
  1077	    if(WS)showHypoScreen(probe); else showGuessScreen(probe);   // ws: сперва СВОЯ гипотеза, до всех подсказок
  1078	  } else {
  1079	    GUIDE.res2={correct,total};
  1080	    if(correct>=3||GUIDE.fixTries>=1){ GUIDE.outcome=correct>=3?'fixed':'partial'; showFinal(); }
  1081	    else{ GUIDE.fixTries++; TELE.push('fix_retry');
  1082	      // повторная починка идёт МИМО выбора (уже выбирал) — вернуть t2a нейтральный интро-текст
  1083	      stepCard({big:'🤔',title:'ИИ ещё путается!',text:'Так бывает. Добавим ему ещё немного разных примеров — и проверим снова.',btn:'🔧 Чинить дальше',onGo:()=>{Object.assign(TASK_INTRO.t2a,T2A_NEUTRAL);startTask('t2a');}}); }
  1084	  }
  1085	}
