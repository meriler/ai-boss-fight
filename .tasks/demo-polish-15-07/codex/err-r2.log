    86	  /* safe center: при переполнении (низкий вьюпорт/клавиатура) контент прижимается к верху и доступен
    87	     скроллом; голый center уводит верх за scroll-origin безвозвратно. Не понял браузер safe — flex-start, тоже ок */
    88	  .screen{position:absolute;inset:0;z-index:20;display:flex;flex-direction:column;align-items:center;justify-content:safe center;text-align:center;padding:26px;gap:16px;background:radial-gradient(120% 90% at 50% 12%,#1a2030,#0b0e14);overflow-y:auto}
    89	  .screen .big{font-size:64px} .screen h1{font-size:clamp(24px,7vw,38px);margin:0} .screen p{color:var(--muted);max-width:380px;line-height:1.5;margin:0;font-size:15px}
    90	  .screen button{flex:0 0 auto;width:min(420px,82vw)}
    91	  .badge{background:#10151e;border:1px solid var(--line);border-radius:999px;padding:6px 13px;font-size:13px;color:var(--muted)}
    92	  .spin{width:34px;height:34px;border:3px solid #2a3445;border-top-color:var(--accent);border-radius:50%;animation:s 1s linear infinite}@keyframes s{to{transform:rotate(360deg)}}
    93	  #loadbarwrap{width:min(360px,76vw);height:10px;background:#10151e;border:1px solid var(--line);border-radius:7px;overflow:hidden}
    94	  #loadbar{height:100%;width:0;background:var(--accent);border-radius:7px;transition:width 1.6s ease-out}
    95	  #rstitle{font-size:clamp(22px,6vw,32px);font-weight:900;margin:0}
    96	  #rsscore{font-size:15px;color:var(--muted)}
    97	  #rsmap{display:flex;flex-direction:column;gap:8px;width:min(440px,86vw)}
    98	  .rscard{background:#10151e;border:1px solid var(--line);border-radius:14px;padding:11px 14px;text-align:left;font-size:15px;font-weight:600}
    99	  .rscard.bad{border-color:var(--bad)} .rscard.good{border-color:var(--ok)}
   100	  #rsdiag{display:flex;flex-direction:column;gap:7px;width:min(440px,86vw)}
   101	  .rsrec{background:rgba(255,207,92,.1);border:1px solid var(--warn);border-radius:12px;padding:9px 13px;font-size:14px;color:var(--text);text-align:left;line-height:1.4}
   102	  #rsbtns{flex-direction:column;gap:10px;width:min(420px,82vw)}
   103	  #rsbtns button{width:100%}
