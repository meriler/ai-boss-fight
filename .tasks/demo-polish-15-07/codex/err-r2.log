  1044	    else if(r.verdict==='wavered'){$('#ckverdict').style.color='var(--warn)';$('#ckverdict').textContent='😵 ИИ заметался — не смог решить!';
  1045	      $('#ckhint').textContent=isProbeMiss?`а ты показывал ${CLASSES[card.cls].emoji} ${CLASSES[card.cls].name}…`:'';}
  1046	    else{$('#ckverdict').style.color='var(--bad)';$('#ckverdict').textContent=`❌ ИИ сказал: ${CLASSES[r.got].emoji} ${CLASSES[r.got].name}!`;
  1047	      $('#ckhint').textContent=isProbeMiss?`а ты показывал ${CLASSES[card.cls].emoji} ${CLASSES[card.cls].name}…`:'';}
  1048	    ckButtons(isProbeMiss?'why':'next');
  1049	  }
  1050	}
  1051	function finishCheck(){
  1052	  checkui.classList.add('hidden');
  1053	  const pc=[{correct:0,confused:0,nohand:0,wavered:0,total:0},{correct:0,confused:0,nohand:0,wavered:0,total:0}];
  1054	  for(const r of CHK.results){pc[r.cls].total++;pc[r.cls][r.verdict]++;}
  1055	  const c0=pc[0].correct,c1=pc[1].correct,totalCorrect=c0+c1,totalCards=CHK.results.length;
  1056	  TELE.push('check_done',{round:CHK.round||0,guided:CHK.guided,correct:totalCorrect,total:totalCards});
  1057	  if(CHK.guided){ finishGuidedCheck(totalCorrect,totalCards); return; }
  1058	  state='train-pause';
  1059	  const outcome = totalCorrect>=Math.ceil(totalCards*0.8) ? 'strong' : totalCorrect>=Math.ceil(totalCards*0.6) ? 'ok' : 'raw';
  1060	  provenTier = outcome==='strong'?2 : outcome==='ok'?1 : 0;
  1061	  showResult({pc,totalCorrect,totalCards,outcome});
  1062	}
