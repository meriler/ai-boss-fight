  1632	function drawSign(s){
  1633	  const x=cv.width*0.5, y=s.y*cv.height, c=CLASSES[s.cls], sz=cv.width*0.13;
  1634	  ctx.save();ctx.globalAlpha=s.judged?Math.max(0,1-(s.y-SIGN_IMPACT)*4):1;
  1635	  ctx.shadowColor=c.color;ctx.shadowBlur=cv.width*0.03;ctx.fillStyle=s.fail?'#ff6b8b':'rgba(14,19,28,.9)';
  1636	  ctx.strokeStyle=s.fail?'#ff6b8b':c.color;ctx.lineWidth=Math.max(3,cv.width*0.008);
  1637	  roundRect(x-sz/2,y-sz/2,sz,sz,cv.width*0.025);ctx.fill();ctx.stroke();
  1638	  ctx.shadowBlur=0;ctx.font='900 '+Math.round(sz*0.52)+'px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillStyle='#fff';ctx.fillText(c.emoji,x,y);
  1639	  if(s.charge>0){ctx.strokeStyle=NEON[0];ctx.lineWidth=Math.max(3,cv.width*0.01);ctx.beginPath();ctx.arc(x,y,sz*0.72,-Math.PI/2,-Math.PI/2+s.charge*2*Math.PI);ctx.stroke();}
  1640	  ctx.restore();
  1641	}
  1642	function roundRect(x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();}
