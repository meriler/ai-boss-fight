   969	function judgeCard(card){
   970	  const s=CHK.samples;
   971	  // замер невалиден (не считается попыткой): руки не было / не тот размер / не тот жест
   972	  const seen=s.filter(x=>x.hand).length, sized=s.filter(x=>x.hand&&x.size).length, formed=s.filter(x=>x.hand&&x.form).length;
   973	  CHK.invalidN=(CHK.invalidN||0);
   974	  const esc=CHK.invalidN>=2 ? ' Если не выходит — позови ведущего 🙋' : '';
   975	  if(!s.length||seen<s.length*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg='🚫 Не увидел руку — попробуем ещё раз.'+esc; TELE.push('shot_invalid',{why:'nohand'}); return; }
   976	  if(CHK.guided&&sized<seen*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg='📏 Рука не того размера — совпади с контуром и замерь снова.'+esc; TELE.push('shot_invalid',{why:'size'}); return; }
   977	  if(CHK.guided&&formed<seen*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg=(card.cls===0?'Это точно ладонь? 🙂 Раскрой пальцы':'Это точно кулак? 🙂 Сожми покрепче')+' — и замерь снова.'+esc; TELE.push('shot_invalid',{why:'form'}); return; }
   978	  CHK.invalidN=0;
   979	  const valid=s.filter(x=>x.label!=null&&!x.far);
   980	  let verdict,got=null;
   981	  if(!valid.length) verdict='nohand';
   982	  else{ const cnt={}; valid.forEach(x=>cnt[x.label]=(cnt[x.label]||0)+1);
   983	    let mj=-1,mc=-1; for(const l in cnt){if(cnt[l]>mc){mc=cnt[l];mj=+l}}
   984	    const frac=mc/valid.length;
   985	    if(frac<0.6){verdict='wavered';got=mj;}
   986	    else if(mj===card.cls)verdict='correct';
   987	    else{verdict='confused';got=mj;}
   988	  }
   989	  CHK.results.push({cls:card.cls,verdict,got});
   990	  if(card.probe&&lastPix)GUIDE.probeShot=new ImageData(new Uint8ClampedArray(lastPix.data),32,32);   // стоп-кадр для «почему»
   991	  CHK.phase='verdict';
   992	  TELE.push('card',{round:CHK.round||0,cls:card.cls,gate:card.gate||null,probe:!!card.probe,verdict,got,
   993	    hand:lastHand.side!=null?+lastHand.side.toFixed(3):null,
   994	    top:predCache?.top||null});                       // разбивка веток соседей — для замера ставки
   995	  if(verdict==='correct')SFX.ding();else SFX.buzz();
   996	}
   997	function tickCheck(now){
   998	  if(!CHK)return; const card=CHK.cards[CHK.idx], el=now-CHK.t0;
   999	  if(camWasDown){if(CHK.phase==='count'||CHK.phase==='hold'){CHK.phase='ready';ckButtons('shot');$('#ckcount3').style.display='none';}return;}
  1000	  if(CHK.phase==='count'){
  1001	    if(!lastHand.ok){ CHK.t0=now-(2-CHK.count)*COUNT_STEP; $('#ckcount3').textContent='🖐'; }   // ждём руку, счёт на паузе
  1002	    else{
  1003	      const c=2-Math.floor(el/COUNT_STEP);
  1004	      if(String(c)!==$('#ckcount3').textContent&&c>0){CHK.count=c;$('#ckcount3').textContent=c;SFX.learn(4-c);}
  1005	      if(el>=2*COUNT_STEP){ $('#ckcount3').style.display='none';
  1006	        CHK.phase='hold'; CHK.t0=now; CHK.samples=[]; CHK.lastSample=0; SFX.ding(); }
  1007	    }
  1008	  }
  1009	  else if(CHK.phase==='hold'){
  1010	    if(el>=HOLD-MEASURE_TAIL && now-CHK.lastSample>=80){ CHK.lastSample=now;
  1011	      CHK.samples.push({label:predCache?predCache.label:null, far:predCache?predCache.far:true,
  1012	        hand:lastHand.ok, size:card.gate?gateOk(card.gate,null,card.cls):true, form:formOkFor(card.cls)}); }
  1013	    if(el>=HOLD){ judgeCard(card); CHK.t0=now; }
  1014	  }
  1015	  renderCheckUI(card,now);
  1016	}
