  1011	  } else if(CHK.phase==='hold'){
  1012	    $('#cktarget').innerHTML=cardTitle(card);
  1013	    $('#ckbar').style.width=Math.min(100,el/HOLD*100)+'%'; $('#ckbar').style.background='var(--warn)';
  1014	    $('#ckverdict').style.color='var(--warn)'; $('#ckverdict').textContent='📸 замеряю…'; $('#ckhint').textContent='держи так!';
  1015	  } else if(CHK.phase==='invalid'){
  1016	    $('#ckbar').style.width='0%';
  1017	    $('#ckverdict').style.color='var(--warn)'; $('#ckverdict').textContent='🤳 Замер не получился';
