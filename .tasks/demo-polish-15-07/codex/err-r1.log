   949	function judgeCard(card){
   950	  const s=CHK.samples;
   951	  // замер невалиден (не считается попыткой): руки не было / не тот размер / не тот жест
   952	  const seen=s.filter(x=>x.hand).length, sized=s.filter(x=>x.hand&&x.size).length, formed=s.filter(x=>x.hand&&x.form).length;
   953	  CHK.invalidN=(CHK.invalidN||0);
   954	  const esc=CHK.invalidN>=2 ? ' Если не выходит — позови ведущего 🙋' : '';
   955	  if(!s.length||seen<s.length*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg='🚫 Не увидел руку — попробуем ещё раз.'+esc; TELE.push('shot_invalid',{why:'nohand'}); return; }
   956	  if(CHK.guided&&sized<seen*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg='📏 Рука не того размера — совпади с контуром и замерь снова.'+esc; TELE.push('shot_invalid',{why:'size'}); return; }
   957	  if(CHK.guided&&formed<seen*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg=(card.cls===0?'Это точно ладонь? 🙂 Раскрой пальцы':'Это точно кулак? 🙂 Сожми покрепче')+' — и замерь снова.'+esc; TELE.push('shot_invalid',{why:'form'}); return; }
   958	  CHK.invalidN=0;
   959	  const valid=s.filter(x=>x.label!=null&&!x.far);
   960	  let verdict,got=null;
   961	  if(!valid.length) verdict='nohand';
   962	  else{ const cnt={}; valid.forEach(x=>cnt[x.label]=(cnt[x.label]||0)+1);
   963	    let mj=-1,mc=-1; for(const l in cnt){if(cnt[l]>mc){mc=cnt[l];mj=+l}}
   964	    const frac=mc/valid.length;
   965	    if(frac<0.6){verdict='wavered';got=mj;}
   966	    else if(mj===card.cls)verdict='correct';
   967	    else{verdict='confused';got=mj;}
   968	  }
   969	  CHK.results.push({cls:card.cls,verdict,got});
   970	  if(card.probe&&lastPix)GUIDE.probeShot=new ImageData(new Uint8ClampedArray(lastPix.data),32,32);   // стоп-кадр для «почему»
   971	  CHK.phase='verdict';
   972	  TELE.push('card',{round:CHK.round||0,cls:card.cls,gate:card.gate||null,probe:!!card.probe,verdict,got,
   973	    hand:lastHand.side!=null?+lastHand.side.toFixed(3):null,
   974	    top:predCache?.top||null});                       // разбивка веток соседей — для замера ставки
   975	  if(verdict==='correct')SFX.ding();else SFX.buzz();
   976	}
   977	function tickCheck(now){
   978	  if(!CHK)return; const card=CHK.cards[CHK.idx], el=now-CHK.t0;
   979	  if(camWasDown){if(CHK.phase==='count'||CHK.phase==='hold'){CHK.phase='ready';ckButtons('shot');$('#ckcount3').style.display='none';}return;}
   980	  if(CHK.phase==='count'){
   981	    if(!lastHand.ok){ CHK.t0=now-(2-CHK.count)*COUNT_STEP; $('#ckcount3').textContent='🖐'; }   // ждём руку, счёт на паузе
   982	    else{
   983	      const c=2-Math.floor(el/COUNT_STEP);
   984	      if(String(c)!==$('#ckcount3').textContent&&c>0){CHK.count=c;$('#ckcount3').textContent=c;SFX.learn(4-c);}
   985	      if(el>=2*COUNT_STEP){ $('#ckcount3').style.display='none';
   986	        CHK.phase='hold'; CHK.t0=now; CHK.samples=[]; CHK.lastSample=0; SFX.ding(); }
   987	    }
   988	  }
   989	  else if(CHK.phase==='hold'){
   990	    if(el>=HOLD-MEASURE_TAIL && now-CHK.lastSample>=80){ CHK.lastSample=now;
   991	      CHK.samples.push({label:predCache?predCache.label:null, far:predCache?predCache.far:true,
   992	        hand:lastHand.ok, size:card.gate?gateOk(card.gate,null,card.cls):true, form:formOkFor(card.cls)}); }
   993	    if(el>=HOLD){ judgeCard(card); CHK.t0=now; }
   994	  }
   995	  renderCheckUI(card,now);
   996	}
