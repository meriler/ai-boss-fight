function resumeFlow(){
  const s=loadSave();
  if(!s){ startFirstTask(); return; }
  applySave(s); refresh(); updateHint();
  TELE.push('resume',{ms:s.ms});
  if(s.ms==='final'&&(GUIDE.res2||GUIDE.outcome)){ showFinal(); }   // no_break/inconclusive: res2 нет, но финал легитимен — не гонять ребёнка по R1 заново
  else if(s.ms==='fixdata'){ if(GUIDE.res2){showFinal();} else {state='gpause'; stepCard({big:'🔧',title:'С возвращением!',text:'Твои примеры целы. Проверим починку ещё раз?',btn:'🔍 Проверить',onGo:()=>startGuidedCheck(2)});} }
