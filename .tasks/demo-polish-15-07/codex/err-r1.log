   851	function startTask(key){
   852	  const intro=TASK_INTRO[key];
   853	  stepCard({...intro,btn:'▶️ Начали!',onGo:()=>{
   854	    const t=TASKS[key]; GUIDE.task={...t,key,got:0}; GUIDE.gateMs=0; GUIDE.lastAdd=0;
   855	    state='gteach';
   856	    guideEl.classList.remove('hidden'); topEl.classList.add('hidden'); bottom.classList.add('hidden');
   857	    gstepEl.textContent=t.step; gtaskEl.innerHTML=t.txt;
   858	    gdotsEl.innerHTML=Array.from({length:t.need},()=>'<i></i>').join('');
   859	    ggateEl.textContent=''; TELE.push('task_start',{task:key});
