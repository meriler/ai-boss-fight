  1044	/* ---- развилки урока после проверки ---- */
  1045	function finishGuidedCheck(correct,total){
  1046	  state='gpause'; topEl.classList.add('hidden');
  1047	  if(CHK.round===1){
  1048	    GUIDE.res1={correct,total};
  1049	    const probe=CHK.results[CHK.results.length-1];    // пробник ✋ ИЗДАЛЕКА — всегда последняя карточка R1
  1050	    if(probe.verdict==='nohand'){                     // редкость: невалидные замеры ловятся раньше
  1051	      TELE.push('inconclusive'); GUIDE.outcome='inconclusive'; showFinal(); return;
  1052	    }
  1053	    if(probe.verdict==='correct'){                    // ИИ не обманулся — редкий честный путь
  1054	      TELE.push('no_break'); GUIDE.outcome='no_break'; showFinal(); return;
  1055	    }
  1056	    TELE.push('break_shown',{verdict:probe.verdict,got:probe.got});
  1057	    if(WS)showHypoScreen(probe); else showGuessScreen(probe);   // ws: сперва СВОЯ гипотеза, до всех подсказок
  1058	  } else {
  1059	    GUIDE.res2={correct,total};
  1060	    if(correct>=3||GUIDE.fixTries>=1){ GUIDE.outcome=correct>=3?'fixed':'partial'; showFinal(); }
  1061	    else{ GUIDE.fixTries++; TELE.push('fix_retry');
  1062	      // повторная починка идёт МИМО выбора (уже выбирал) — вернуть t2a нейтральный интро-текст
  1063	      stepCard({big:'🤔',title:'ИИ ещё путается!',text:'Так бывает. Добавим ему ещё немного разных примеров — и проверим снова.',btn:'🔧 Чинить дальше',onGo:()=>{Object.assign(TASK_INTRO.t2a,T2A_NEUTRAL);startTask('t2a');}}); }
  1064	  }
  1065	}
  1066	function recommend(pc,outcome){
  1067	  const recs=[];
  1068	  if(outcome!=='strong'){
  1069	    recs.push('ИИ знает только то, что ты ему показал. Если все примеры похожи — он цепляется за случайное (размер, место, фон).');
  1070	    recs.push('Почини данными: покажи каждый жест ПО-РАЗНОМУ — близко, далеко, под углом.');
  1071	    return recs;
  1072	  }
  1073	  const mn=Math.min(counts[0],counts[1]),mx=Math.max(counts[0],counts[1]);
  1074	  if(mx>=mn*2+2){const less=counts[0]<counts[1]?0:1;recs.push(`Перекос: ${CLASSES[0].emoji} ${counts[0]} · ${CLASSES[1].emoji} ${counts[1]}. Добери ${CLASSES[less].emoji}.`);}
  1075	  for(let c=0;c<2;c++){ if(pc[c].confused>=2)recs.push(`ИИ путал ${CLASSES[c].emoji} ${CLASSES[c].name} с ${CLASSES[1-c].emoji}. Добери ${CLASSES[c].emoji} в разных местах и с разным фоном.`); }
  1076	  if(!recs.length && outcome!=='strong')recs.push('Добери по 6–8 РАЗНЫХ примеров каждого: меняй место, расстояние, наклон, фон.');
  1077	  return recs.slice(0,2);
  1078	}
  1079	/* ---- сертификат под сторис (client-side, ничего не уходит с устройства) ---- */
  1080	function wrapLinesCanvas(x,text,maxW){
  1081	  const words=text.split(' '),lines=[];let cur='';
  1082	  for(const w of words){ const t=cur?cur+' '+w:w; if(x.measureText(t).width>maxW&&cur){lines.push(cur);cur=w;} else cur=t; }
  1083	  if(cur)lines.push(cur); return lines;
  1084	}
  1085	/* ===== СЕРТИФИКАТ-АЧИВКА под сторис (1080×1920) =====
  1086	   Генеративная рамка ФТИИ (3 стиля, выбор случайный) + чистый центр на canvas.
  1087	   Окно внутри рамки детектится по профилю активности → контент центрируется,
