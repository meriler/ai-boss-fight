   886	  else if(key==='t1b') stepCard({big:'🎓',title:'ИИ обучен!',text:'6 ладоней и 6 кулаков. Теперь проверим, чему он на самом деле научился. Показывай жесты и жми «ЗАМЕРИТЬ».',btn:'🔍 Проверить ИИ',onGo:()=>startGuidedCheck(1)});
