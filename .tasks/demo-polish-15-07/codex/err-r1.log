   862	function tickGuidedTeach(){
   863	  const T=GUIDE.task; if(!T)return;
   864	  if(camWasDown){GUIDE.gateMs=0;return;}   // камера отпала — замираем
   865	  const sizeOk=gateOk(T.gate,null,T.cls), form=formOkFor(T.cls);
   866	  const ok=sizeOk&&form, now=performance.now();
   867	  const txt=sizeOk&&!form ? formHint(T.cls) : gateHint(T.gate,null,T.cls);
   868	  if(txt!==ggateEl.textContent && (now-(tickGuidedTeach._ts||0)>600)){   // троттл: на границе порога текст не стробит
   869	    ggateEl.textContent=txt; ggateEl.className=ok?'ok':'no'; tickGuidedTeach._ts=now; }
   870	  if(ok){GUIDE.gateMs+=60;GUIDE.stuckMs=0;} else {GUIDE.gateMs=0;GUIDE.stuckMs=(GUIDE.stuckMs||0)+60;}
   871	  // гейт не проходит очень долго → подсказка позвать ведущего (и след в телеметрии)
   872	  if(GUIDE.stuckMs>25000){GUIDE.stuckMs=0;TELE.push('gate_stuck',{task:T.key});showToast('Не выходит? Позови ведущего 🙋',2000);}
   873	  if(GUIDE.gateMs>=CFG.gateHoldMs && now-GUIDE.lastAdd>=CFG.sampleCdMs){
   874	    GUIDE.lastAdd=now;
   875	    if(addExample(T.cls,T.round)){
   876	      T.got++;                                   // «щёлк» кадра — в addExample (прогон 13.07: темп 900мс требует явной отсечки)
   877	      [...gdotsEl.children].forEach((d,i)=>d.classList.toggle('on',i<T.got));
   878	      if(T.got>=T.need){ GUIDE.task=null; TELE.push('task_done',{task:T.key});
   879	        state='gpause'; nextAfterTask(T.key); }
   880	    }
   881	  }
   882	}
