   687	  if(D.cls===0){ // «ладонь»: 4 широких пальца + основание; s=1 заполняет большую часть кадра
   688	    for(let f=0;f<4;f++)dcx.fillRect(cx-52*s+f*28*s, cy-90*s, 22*s, 130*s);
