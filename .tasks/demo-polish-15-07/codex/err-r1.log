   682	  dcx.fillStyle='#33465a'; for(let i=0;i<6;i++)dcx.fillRect(20+i*34,170,18,40);
   683	  dcx.fillStyle='#223140'; dcx.fillRect(0,0,224,26);
   684	  if(!D.present)return;
