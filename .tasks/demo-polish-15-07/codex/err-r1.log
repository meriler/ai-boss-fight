   907	  if(!card.gate)return `<span class="em">${c.emoji}</span>${c.name} — в рамке`;
   908	  return card.gate==='big'
   909	    ? `<span class="em">${c.emoji}</span>${c.name} — ${fem?'БОЛЬШАЯ':'БОЛЬШОЙ'}, как контур`
