  1113	  for(let y=0;y<H;y++){let s=0,n=0;for(let x=x0;x<x1;x++){const i=(y*W+x)*4,i2=(y*W+x+1)*4;s+=Math.abs(lum(i)-lum(i2));n++;}rowAct[y]=s/n;}
