  1116	  const calm=(arr,idx,t)=>{let bad=0;for(let k=-3;k<=3;k++){const v=arr[idx+k];if(v!=null&&v>t)bad++;}return bad<=1;};
  1117	  let L=cx;while(L>2&&calm(colAct,L,tx))L--;let R=cx;while(R<W-3&&calm(colAct,R,tx))R++;
