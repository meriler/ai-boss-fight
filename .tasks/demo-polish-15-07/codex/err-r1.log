  1035	  const c0=pc[0].correct,c1=pc[1].correct,totalCorrect=c0+c1,totalCards=CHK.results.length;
  1036	  TELE.push('check_done',{round:CHK.round||0,guided:CHK.guided,correct:totalCorrect,total:totalCards});
  1037	  if(CHK.guided){ finishGuidedCheck(totalCorrect,totalCards); return; }
  1038	  state='train-pause';
