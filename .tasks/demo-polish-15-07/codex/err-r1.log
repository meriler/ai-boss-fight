   676	const demoCv=document.createElement('canvas'); demoCv.width=224; demoCv.height=224; const dcx=demoCv.getContext('2d');
   677	window.__demo={cls:0,size:1.0,present:true};   // cls: 0 ладонь/1 кулак; size: 1=вплотную, 0.2=далеко
   678	function drawDemoFrame(){
