  1229	    const gh=CHK.guided&&card.gate&&lastHand.ok&&!gateOk(card.gate,null,card.cls)?gateHint(card.gate,null,card.cls):null;
  1230	    $('#ckhint').textContent=gh||'жми кнопку или ПРОБЕЛ — счёт подождёт твою руку';
  1231	  } else if(CHK.phase==='count'){
  1232	    $('#cktarget').innerHTML=cardTitle(card);
  1233	    $('#ckhint').textContent=CHK.guided&&card.gate?gateHint(card.gate,null,card.cls):'';
  1234	  } else if(CHK.phase==='hold'){
  1235	    $('#cktarget').innerHTML=cardTitle(card);
  1236	    $('#ckbar').style.width=Math.min(100,el/HOLD*100)+'%'; $('#ckbar').style.background='var(--warn)';
  1237	    $('#ckverdict').style.color='var(--warn)'; $('#ckverdict').textContent='📸 замеряю…'; $('#ckhint').textContent='держи так!';
  1238	  } else if(CHK.phase==='invalid'){
  1239	    $('#ckbar').style.width='0%';
  1240	    $('#ckverdict').style.color='var(--warn)'; $('#ckverdict').textContent='🤳 Замер не получился';
  1241	    $('#ckhint').textContent=CHK.invalidMsg||''; ckButtons('retry');
  1242	  } else if(CHK.phase==='verdict'){
  1243	    const r=CHK.results[CHK.idx]; $('#ckbar').style.width='100%';
  1244	    const isProbeMiss=CHK.guided&&CHK.round===1&&card.probe&&r.verdict!=='correct';
  1245	    if(r.verdict==='correct'){$('#ckverdict').style.color='var(--ok)';$('#ckverdict').textContent='✅ Верно!';$('#ckhint').textContent='';}
  1246	    else if(r.verdict==='nohand'){$('#ckverdict').style.color='var(--warn)';$('#ckverdict').textContent='🚫 не разобрал кадр';$('#ckhint').textContent='';}
  1247	    else if(r.verdict==='wavered'){$('#ckverdict').style.color='var(--warn)';$('#ckverdict').textContent='😵 ИИ заметался — не смог решить!';
  1248	      $('#ckhint').textContent=isProbeMiss?`а ты показывал ${CLASSES[card.cls].emoji} ${CLASSES[card.cls].name}…`:'';}
  1249	    else{$('#ckverdict').style.color='var(--bad)';$('#ckverdict').textContent=`❌ ИИ сказал: ${CLASSES[r.got].emoji} ${CLASSES[r.got].name}!`;
  1250	      $('#ckhint').textContent=isProbeMiss?`а ты показывал ${CLASSES[card.cls].emoji} ${CLASSES[card.cls].name}…`:'';}
  1251	    ckButtons(isProbeMiss?'why':'next');
  1252	  }
  1253	}
