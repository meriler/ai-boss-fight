  1500	/* атомарное удаление n-й карточки класса: KNN.ex (общий список) и THUMBS[cls] идут синхронно
  1501	   по порядку добавления; counts пересчитываем из факта, не декрементим (ревью Codex 14.07).
  1502	   Доступно только post-final (иначе рвёт guided-замеры), с персистом — F5 не воскрешает удалённое. */
  1503	function delExample(cls,n){
  1504	  let idx=-1,seen=0;
  1505	  for(let i=0;i<KNN.ex.length;i++){ if(KNN.ex[i].l===cls){ if(seen===n){idx=i;break;} seen++; } }
  1506	  if(idx<0||!THUMBS[cls][n])return false;
  1507	  KNN.ex.splice(idx,1); THUMBS[cls].splice(n,1);
  1508	  counts[cls]=KNN.ex.filter(x=>x.l===cls).length;
  1509	  predCache=null; smooth.length=0;
  1510	  // сертификату нужен живой кадр: удалили ладонь → последняя оставшаяся ладонь, иначе любой пример
  1511	  certFrame=THUMBS[0].length?THUMBS[0][THUMBS[0].length-1].img:(THUMBS[1].length?THUMBS[1][THUMBS[1].length-1].img:null);
  1512	  TELE.push('sample_del',{cls});
  1513	  clearTimeout(delExample._t); delExample._t=setTimeout(()=>{try{saveMilestone('final')}catch(e){}},1200);
  1514	  refresh(); updateHint(); return true;
  1515	}
