  1330	// детект внутреннего пустого окна рамки (рамка — высокая «детальность» по периметру, центр гладкий)
  1331	function detectInnerRect(data,W,H){
  1332	  const lum=i=>0.299*data[i]+0.587*data[i+1]+0.114*data[i+2];
  1333	  const cx=W>>1,cy=H>>1;
  1334	  const y0=(H*0.40)|0,y1=(H*0.60)|0,colAct=new Float32Array(W);
  1335	  for(let x=0;x<W;x++){let s=0,n=0;for(let y=y0;y<y1;y++){const i=(y*W+x)*4,i2=((y+1)*W+x)*4;s+=Math.abs(lum(i)-lum(i2));n++;}colAct[x]=s/n;}
  1336	  const x0=(W*0.40)|0,x1=(W*0.60)|0,rowAct=new Float32Array(H);
  1337	  for(let y=0;y<H;y++){let s=0,n=0;for(let x=x0;x<x1;x++){const i=(y*W+x)*4,i2=(y*W+x+1)*4;s+=Math.abs(lum(i)-lum(i2));n++;}rowAct[y]=s/n;}
  1338	  const thr=a=>{let m=0;for(const v of a)m=Math.max(m,v);return m*0.16;};
  1339	  const tx=thr(colAct),ty=thr(rowAct);
  1340	  const calm=(arr,idx,t)=>{let bad=0;for(let k=-3;k<=3;k++){const v=arr[idx+k];if(v!=null&&v>t)bad++;}return bad<=1;};
  1341	  let L=cx;while(L>2&&calm(colAct,L,tx))L--;let R=cx;while(R<W-3&&calm(colAct,R,tx))R++;
  1342	  let T=cy;while(T>2&&calm(rowAct,T,ty))T--;let B=cy;while(B<H-3&&calm(rowAct,B,ty))B++;
  1343	  return {x:L,y:T,w:R-L,h:B-T};
  1344	}
