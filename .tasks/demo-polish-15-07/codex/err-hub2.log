    34	def dedupe(raws, include_demo=False, ws_only=True):
    35	    """Записи → дампы по sid (самый полный побеждает; при равенстве — поздний по порядку чтения).
    36	
    37	    Попутно каждому дампу пишется окно приёма его sid: _recv_first/_recv_last (по серверным часам) —
    38	    для детекта одновременных сессий одного места (шаринг ссылки; Codex 10.07)."""
    39	    dumps, spans = {}, {}
    40	    for r in raws:
    41	        d = r.get('data', r)
    42	        if not isinstance(d, dict) or 'sid' not in d:
    43	            continue
    44	        if d.get('demo') and not include_demo:
    45	            continue
    46	        if ws_only and not d.get('ws'):
    47	            continue
    48	        d['_recv'] = r.get('recv')
    49	        t = _parse_iso(r.get('recv'))
    50	        if t:
    51	            a, b = spans.get(d['sid'], (t, t))
    52	            spans[d['sid']] = (min(a, t), max(b, t))
    53	        old = dumps.get(d['sid'])
    54	        if not old or len(d.get('events', [])) >= len(old.get('events', [])):
    55	            dumps[d['sid']] = d
    56	    for sid, d in dumps.items():
    57	        d['_recv_first'], d['_recv_last'] = spans.get(sid, (None, None))
    58	    return list(dumps.values())
