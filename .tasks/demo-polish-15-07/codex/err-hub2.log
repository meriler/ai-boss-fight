  1518	  editable=editable&&allRounds;   // фильтрованный список рассинхронил бы индексы удаления
  1519	  gal.innerHTML='';
  1520	  [[0,'✋ Все ладони, что ты показал:'],[1,'✊ Все кулаки:']].forEach(([cls,label])=>{
  1521	    const row=document.createElement('div'); row.className='galrow';
  1522	    const gl=document.createElement('div'); gl.className='gl'; gl.textContent=label; row.appendChild(gl);
  1523	    THUMBS[cls].filter(t=>allRounds||t.round===1).forEach((t,n)=>{
  1524	      const c=document.createElement('canvas'); c.width=32; c.height=32;
  1525	      c.getContext('2d').putImageData(t.img,0,0);
  1526	      if(!editable){ row.appendChild(c); return; }
  1527	      const cw=document.createElement('span'); cw.className='cw'; cw.appendChild(c);
  1528	      const x=document.createElement('button'); x.className='crd-del'; x.textContent='✕';
  1529	      x.onclick=(e)=>{ e.stopPropagation();   // два тапа: первый «взводит» (красная рамка), второй удаляет
  1530	        if(!cw.classList.contains('arm')){ cw.classList.add('arm'); x.textContent='❗';
  1531	          setTimeout(()=>{cw.classList.remove('arm');x.textContent='✕';},2000); return; }
  1532	        if(delExample(cls,n)){ showToast('Карточка убрана из альбома',900); buildGallery(gal,allRounds,true); } };
  1533	      cw.appendChild(x); row.appendChild(cw); });
  1534	    gal.appendChild(row);
