  1170	function judgeCard(card){
  1171	  const s=CHK.samples;
  1172	  // замер невалиден (не считается попыткой): руки не было / не тот размер / не тот жест
  1173	  const seen=s.filter(x=>x.hand).length, sized=s.filter(x=>x.hand&&x.size).length, formed=s.filter(x=>x.hand&&x.form).length;
  1174	  CHK.invalidN=(CHK.invalidN||0);
  1175	  const esc=CHK.invalidN>=2 ? ' Если не выходит — позови ведущего 🙋' : '';
  1176	  if(!s.length||seen<s.length*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg='🚫 Не увидел руку — попробуем ещё раз.'+esc; TELE.push('shot_invalid',{why:'nohand'}); return; }
  1177	  if(CHK.guided&&sized<seen*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg='📏 Рука не того размера — совпади с контуром и замерь снова.'+esc; TELE.push('shot_invalid',{why:'size'}); return; }
  1178	  if(CHK.guided&&formed<seen*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg=(card.cls===0?'Это точно ладонь? 🙂 Раскрой пальцы':'Это точно кулак? 🙂 Сожми покрепче')+' — и замерь снова.'+esc; TELE.push('shot_invalid',{why:'form'}); return; }
  1179	  CHK.invalidN=0;
  1180	  const valid=s.filter(x=>x.label!=null&&!x.far);
  1181	  let verdict,got=null;
  1182	  if(!valid.length) verdict='nohand';
  1183	  else{ const cnt={}; valid.forEach(x=>cnt[x.label]=(cnt[x.label]||0)+1);
  1184	    let mj=-1,mc=-1; for(const l in cnt){if(cnt[l]>mc){mc=cnt[l];mj=+l}}
  1185	    const frac=mc/valid.length;
  1186	    if(frac<0.6){verdict='wavered';got=mj;}
  1187	    else if(mj===card.cls)verdict='correct';
  1188	    else{verdict='confused';got=mj;}
  1189	  }
  1190	  CHK.results.push({cls:card.cls,verdict,got});
  1191	  if(card.probe&&lastPix)GUIDE.probeShot=new ImageData(new Uint8ClampedArray(lastPix.data),32,32);   // стоп-кадр для «почему»
  1192	  CHK.phase='verdict';
  1193	  TELE.push('card',{round:CHK.round||0,cls:card.cls,gate:card.gate||null,probe:!!card.probe,verdict,got,
  1194	    hand:lastHand.side!=null?+lastHand.side.toFixed(3):null,
  1195	    top:predCache?.top||null});                       // разбивка веток соседей — для замера ставки
  1196	  if(verdict==='correct')SFX.ding();else SFX.buzz();
  1197	}
  1198	function tickCheck(now){
  1199	  if(!CHK)return; const card=CHK.cards[CHK.idx], el=now-CHK.t0;
  1200	  if(camWasDown){if(CHK.phase==='count'||CHK.phase==='hold'){CHK.phase='ready';ckButtons('shot');$('#ckcount3').style.display='none';}return;}
  1201	  if(CHK.phase==='count'){
  1202	    if(!lastHand.ok){ CHK.t0=now-(2-CHK.count)*COUNT_STEP; $('#ckcount3').textContent='🖐'; }   // ждём руку, счёт на паузе
  1203	    else{
  1204	      const c=2-Math.floor(el/COUNT_STEP);
  1205	      if(String(c)!==$('#ckcount3').textContent&&c>0){CHK.count=c;$('#ckcount3').textContent=c;SFX.learn(4-c);}
  1206	      if(el>=2*COUNT_STEP){ $('#ckcount3').style.display='none';
  1207	        CHK.phase='hold'; CHK.t0=now; CHK.samples=[]; CHK.lastSample=0; SFX.ding(); }
  1208	    }
  1209	  }
  1210	  else if(CHK.phase==='hold'){
  1211	    if(el>=HOLD-MEASURE_TAIL && now-CHK.lastSample>=80){ CHK.lastSample=now;
  1212	      CHK.samples.push({label:predCache?predCache.label:null, far:predCache?predCache.far:true,
  1213	        hand:lastHand.ok, size:card.gate?gateOk(card.gate,null,card.cls):true, form:formOkFor(card.cls)}); }
  1214	    if(el>=HOLD){ judgeCard(card); CHK.t0=now; }
  1215	  }
  1216	  renderCheckUI(card,now);
  1217	}
