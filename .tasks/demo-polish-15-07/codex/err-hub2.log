  1592	    GUIDE.fixChosen='shown';
  1593	    $('#fixhint').innerHTML='Правильный ход — <b>наоборот</b>: маленькие ладони и большие кулаки. ИИ нужно увидеть то, чего НЕ БЫЛО в его примерах.';
  1594	    $('#fixhint').classList.remove('hidden');
  1595	    const btns=$('#fixbtns'); btns.innerHTML='';
  1596	    const b=document.createElement('button'); b.className='ok'; b.style.cssText='width:min(340px,74vw);flex:0 0 auto';
  1597	    b.textContent='🔧 Чинить'; b.onclick=goFix; btns.appendChild(b);
  1598	    return;
  1599	  }
  1600	  $('#fixhint').innerHTML='Вспомни разгадку: ВСЕ твои ладони были большими, а кулаки маленькими. Чего ИИ ещё ни разу не видел?';
