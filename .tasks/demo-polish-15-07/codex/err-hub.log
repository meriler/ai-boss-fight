   946	/* ====================== ПРОВЕРКА (общая для урока и лаборатории) ====================== */
   947	const CARDS_PER_CLASS=4;
   948	const HOLD=900,MEASURE_TAIL=780,COUNT_STEP=700;   // замер короткий: почти весь идёт в samples
   949	let CHK=null;
   950	function shuffledCards(){const a=[];for(let c=0;c<CLASSES.length;c++)for(let n=0;n<CARDS_PER_CLASS;n++)a.push({cls:c});
   951	  for(let i=a.length-1;i>0;i--){const j=(Math.random()*(i+1))|0;[a[i],a[j]]=[a[j],a[i]]}
   952	  return a;}
   953	// карточки урока. R1: две «как учили» (доверие) + пробник — ✋ ИЗДАЛЕКА (надёжное направление поломки).
   954	// R2: те же + оба «наоборот» — теперь должны узнаваться.
   955	function guidedCards(round){
   956	  return round===1
   957	    ? [{cls:0,gate:'big'},{cls:1,gate:'small'},{cls:0,gate:'small',probe:true}]
   958	    : [{cls:0,gate:'big'},{cls:1,gate:'small'},{cls:0,gate:'small',probe:true},{cls:1,gate:'big',probe:true}];
   959	}
   960	function cardTitle(card){
   961	  const c=CLASSES[card.cls], fem=card.cls===0;   // род: ладонь БОЛЬШАЯ, кулак БОЛЬШОЙ (смок 09.07)
   962	  if(!card.gate)return `<span class="em">${c.emoji}</span>${c.name} — в рамке`;
   963	  return card.gate==='big'
   964	    ? `<span class="em">${c.emoji}</span>${c.name} — ${fem?'БОЛЬШАЯ':'БОЛЬШОЙ'}, как контур`
   965	    : `<span class="em">${c.emoji}</span>${c.name} — ${fem?'маленькая':'маленький'}, как контур`;
   966	}
   967	function ckButtons(mode){ // 'shot' | 'retry' | 'next' | 'why' | none
