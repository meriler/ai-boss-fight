   109	def _parse_iso(s):
   110	    try:
   111	        s = (s or '').replace('Z', '+00:00')
   112	        s = re.sub(r'([+-]\d{2})(\d{2})$', r'\1:\2', s)  # '+0300' → '+03:00': fromisoformat до py3.11 иначе падает
   113	        return datetime.fromisoformat(s)
   114	    except Exception:
   115	        return None
   116	
