  1723	  const r2=GUIDE.res2, r2ok=!!r2&&Number.isFinite(r2.correct)&&Number.isFinite(r2.total)&&r2.correct>=0&&r2.total>0;   // res2={} — не результат
  1724	  const finOk=FIN.includes(GUIDE.outcome)&&((GUIDE.outcome!=='fixed'&&GUIDE.outcome!=='partial')||r2ok);   // fixed/partial без валидного res2 = битый инвариант
  1725	  if(s.ms==='final'&&finOk){ showFinal(); }   // no_break/inconclusive: res2 нет, но финал легитимен
  1726	  else if(s.ms==='fixdata'){ // ВСЕГДА через проверку R2: res2 в сейве бывает провальным ПЕРВЫМ замером
  1727	    // (F5 во время дополнительной починки) — прямой showFinal рисовал «Почти починил» до второй проверки (Codex CRIT 14.07)
  1728	    state='gpause'; stepCard({big:'🔧',title:'С возвращением!',text:'Твои примеры целы. Проверим починку ещё раз?',album:true,btn:'🔍 Проверить',onGo:()=>startGuidedCheck(2)}); }
  1729	  else if(s.ms==='revealed'){ showRevealScreen(); }
