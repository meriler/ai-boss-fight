   185	def _invalid_tail(events):
   186	    """Сколько shot_invalid подряд в ХВОСТЕ событий (perf-heartbeat пропускаем, любой другой
   187	    тип обрывает серию) — live-сигнал «не может собрать кадр прямо сейчас»."""
   188	    n = 0
   189	    for e in reversed(events):
   190	        t = e.get('type')
   191	        if t == 'perf':
