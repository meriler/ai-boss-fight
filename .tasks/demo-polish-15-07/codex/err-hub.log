  1062	    // живая подсказка размера ЕЩЁ ДО нажатия: вплотную к камере детектор слепнет, а без подсказки
  1063	    // ребёнок не понимает, чего от него ждут (смок 09.07: кулак во весь кадр)
  1064	    const gh=CHK.guided&&card.gate&&lastHand.ok&&!gateOk(card.gate,null,card.cls)?gateHint(card.gate,null,card.cls):null;
  1065	    $('#ckhint').textContent=gh||'жми кнопку или ПРОБЕЛ — счёт подождёт твою руку';
  1066	  } else if(CHK.phase==='count'){
  1067	    $('#cktarget').innerHTML=cardTitle(card);
  1068	    $('#ckhint').textContent=CHK.guided&&card.gate?gateHint(card.gate,null,card.cls):'';
  1069	  } else if(CHK.phase==='hold'){
  1070	    $('#cktarget').innerHTML=cardTitle(card);
  1071	    $('#ckbar').style.width=Math.min(100,el/HOLD*100)+'%'; $('#ckbar').style.background='var(--warn)';
  1072	    $('#ckverdict').style.color='var(--warn)'; $('#ckverdict').textContent='📸 замеряю…'; $('#ckhint').textContent='держи так!';
  1073	  } else if(CHK.phase==='invalid'){
  1074	    $('#ckbar').style.width='0%';
  1075	    $('#ckverdict').style.color='var(--warn)'; $('#ckverdict').textContent='🤳 Замер не получился';
  1076	    $('#ckhint').textContent=CHK.invalidMsg||''; ckButtons('retry');
  1077	  } else if(CHK.phase==='verdict'){
  1078	    const r=CHK.results[CHK.idx]; $('#ckbar').style.width='100%';
  1079	    const isProbeMiss=CHK.guided&&CHK.round===1&&card.probe&&r.verdict!=='correct';
  1080	    if(r.verdict==='correct'){$('#ckverdict').style.color='var(--ok)';$('#ckverdict').textContent='✅ Верно!';$('#ckhint').textContent='';}
  1081	    else if(r.verdict==='nohand'){$('#ckverdict').style.color='var(--warn)';$('#ckverdict').textContent='🚫 не разобрал кадр';$('#ckhint').textContent='';}
  1082	    else if(r.verdict==='wavered'){$('#ckverdict').style.color='var(--warn)';$('#ckverdict').textContent='😵 ИИ заметался — не смог решить!';
  1083	      $('#ckhint').textContent=isProbeMiss?`а ты показывал ${CLASSES[card.cls].emoji} ${CLASSES[card.cls].name}…`:'';}
  1084	    else{$('#ckverdict').style.color='var(--bad)';$('#ckverdict').textContent=`❌ ИИ сказал: ${CLASSES[r.got].emoji} ${CLASSES[r.got].name}!`;
  1085	      $('#ckhint').textContent=isProbeMiss?`а ты показывал ${CLASSES[card.cls].emoji} ${CLASSES[card.cls].name}…`:'';}
  1086	    ckButtons(isProbeMiss?'why':'next');
  1087	  }
  1088	}
  1089	function finishCheck(){
  1090	  checkui.classList.add('hidden');
  1091	  const pc=[{correct:0,confused:0,nohand:0,wavered:0,total:0},{correct:0,confused:0,nohand:0,wavered:0,total:0}];
  1092	  for(const r of CHK.results){pc[r.cls].total++;pc[r.cls][r.verdict]++;}
  1093	  const c0=pc[0].correct,c1=pc[1].correct,totalCorrect=c0+c1,totalCards=CHK.results.length;
  1094	  TELE.push('check_done',{round:CHK.round||0,guided:CHK.guided,correct:totalCorrect,total:totalCards});
  1095	  if(CHK.guided){ finishGuidedCheck(totalCorrect,totalCards); return; }
  1096	  state='train-pause';
  1097	  const outcome = totalCorrect>=Math.ceil(totalCards*0.8) ? 'strong' : totalCorrect>=Math.ceil(totalCards*0.6) ? 'ok' : 'raw';
  1098	  provenTier = outcome==='strong'?2 : outcome==='ok'?1 : 0;
  1099	  showResult({pc,totalCorrect,totalCards,outcome});
  1100	}
