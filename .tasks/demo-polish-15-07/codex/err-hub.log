    21	def parse_lines(lines):
    22	    """Строки JSONL → (сырые записи, число битых строк)."""
    23	    raws, bad = [], 0
    24	    for l in lines:
    25	        if not l.strip():
    26	            continue
    27	        try:
    28	            raws.append(json.loads(l))
    29	        except Exception:
