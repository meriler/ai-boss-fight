  1001	function ckNextClick(){
  1002	  if(!CHK||CHK.phase!=='verdict')return;   // двойной клик не должен пропустить карточку
  1003	  CHK.idx++;
  1004	  if(CHK.idx>=CHK.cards.length){ finishCheck(); return; }
