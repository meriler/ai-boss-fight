   233	    сессия отдельной строкой «?·xxxx» (вопрос Алексея 10.07).
   234	    names: {"5": "Серёжа К."} — локальный маппинг место→имя (seats.json на сервере;
   235	    телеметрия с устройств остаётся псевдонимной, имя присоединяется только при чтении)."""
   236	    names = names or {}
   237	    by_seat = {}
   238	    for d in dumps:
   239	        key = d.get('seat')
   240	        if key is None:
   241	            key = '?·' + str(d.get('sid'))[:4]
   242	        by_seat.setdefault(key, []).append(d)
   243	    out = []
   244	    for seat in sorted(by_seat, key=lambda s: (isinstance(s, str), str(s))):
   245	        sessions = by_seat[seat]
   246	        with_final = [d for d in sessions if ev(d['events'], 'final_summary')]
   247	        # выбор ТОЛЬКО по raw серверному приёму (_recv): клиентские часы для склейки не годятся
   248	        # (Codex P0 10.07); client-derived время — только для статуса живости
   249	        far_past = datetime.min.replace(tzinfo=timezone.utc)
   250	        raw_recv = lambda d: _parse_iso(d.get('_recv')) or far_past
   251	        main_d = max(with_final, key=raw_recv) if with_final \
   252	            else max(sessions, key=lambda d: (raw_recv(d), len(d['events'])))
   253	        # детект «двое на одном месте»: окна приёма двух sid пересекаются дольше 60с (шаринг ссылки)
   254	        mixed = False
   255	        for i in range(len(sessions)):
   256	            for j in range(i + 1, len(sessions)):
   257	                a, b = sessions[i], sessions[j]
   258	                if not (a.get('_recv_first') and b.get('_recv_first')):
   259	                    continue
   260	                lo = max(a['_recv_first'], b['_recv_first'])
   261	                hi = min(a['_recv_last'], b['_recv_last'])
   262	                if (hi - lo).total_seconds() > 60:
   263	                    mixed = True
   264	        events = main_d['events']
   265	        fss = ev(events, 'final_summary')
   266	        fs = fss[-1] if fss else None
   267	        hyp = (ev(events, 'hypothesis') or [None])[-1]
   268	        fixes = ev(events, 'fix_choice')
   269	        surv = ev(events, 'survey_answer')
   270	        seen = max((t for t in (last_seen(d) for d in sessions) if t), default=None)
   271	        # r1/r2: из final_summary; НЕТ final_summary («не досидел») → fallback из последнего
   272	        # check_done ленты — иначе у недосидевших теряется точность раунда 1 (аудит 10.07)
   273	        if fs:
   274	            r1, r2 = fs.get('r1'), fs.get('r2')
   275	        else:
   276	            def _cd(rounds):
   277	                for e in reversed(events):
   278	                    if e.get('type') == 'check_done' and e.get('round') in rounds \
   279	                            and isinstance(e.get('correct'), int) and isinstance(e.get('total'), int):
   280	                        return {'correct': e['correct'], 'total': e['total']}
   281	                return None
   282	            r1, r2 = _cd((0, 1)), _cd((2,))
   283	        # агрегаты по ВСЕМ сессиям места: невалидные кадры (какой гейт душит), дропы камеры, артефакт
   284	        inv = {}
   285	        for d in sessions:
   286	            for e in ev(d['events'], 'shot_invalid'):
   287	                w = e.get('why') or '?'
   288	                inv[w] = inv.get(w, 0) + 1
   289	        cam_drops = sum(len(ev(d['events'], 'cam_drop')) for d in sessions)
   290	        cert = any(ev(d['events'], 'cert_made') for d in sessions)
   291	        # session-scoped (главная сессия): железо, тайминги, буксование — старый F5 не должен искажать
   292	        fps_min, fps_med = _fps_stats(events)
   293	        stuck_last = max((t for t in (_ev_time(d, (ev(d['events'], 'gate_stuck') or [{}])[-1].get('t'))
   294	                                      for d in sessions) if t), default=None)
   295	        if isinstance(seat, str) and seat.startswith('?'):
   296	            klass = 'без места (открыл не по своей ссылке)'
   297	        elif not fs and len(events) <= 3:
   298	            klass = 'TELEMETRY_LOST (ранний обрыв)'
   299	        elif not fs:
   300	            klass = f'не досидел (стадия: {last_stage(events)})'
   301	        else:
   302	            klass = cell(fs, fixes)
   303	        out.append({
   304	            'seat': seat, 'name': names.get(str(seat), ''),
   305	            'stage': last_stage(events), 'last_seen': seen,
   306	            'hyp': ('🤷 не знаю' if hyp and hyp.get('dontknow') else (hyp or {}).get('text') or '—'),
   307	            'guessCat': (fs or {}).get('guessCat') or '—',
   308	            'fixChosen': ((fs or {}).get('fixChosen') or '—') + (f" ({len(fixes)} поп.)" if fixes else ''),
   309	            'stuck': len(ev(events, 'gate_stuck')),
   310	            'r1': r1, 'r2': r2,
   311	            'survey': [s.get('text', '') for s in surv],
   312	            'klass': klass + (' · ⚠️ данные смешаны (две одновременные сессии)' if mixed else ''),
   313	            'mixed': mixed, 'restarts': len(sessions) - 1,
   314	            'broke': bool(ev(events, 'break_shown')),
   315	            # аудит 10.07: операционка и live-сигналы буксования
   316	            'inv': inv, 'inv_tail': _invalid_tail(events), 'lock_fails': _lock_fails(events),
   317	            'stuck_last': stuck_last, 'cam_drops': cam_drops, 'cert': cert,
   318	            'boot_dead': _boot_dead(sessions, raw_recv),
   319	            'os': main_d.get('os') or '?', 'mobile': bool(main_d.get('mobile')),
   320	            'fps_min': fps_min, 'fps_med': fps_med,
   321	            'stage_min': stage_times(events),
   322	            'dur_min': round(max((e.get('t', 0) for e in events), default=0) / 60000, 1),
   323	            'roster_only': False, 'sids': [str(d.get('sid')) for d in sessions],
   324	        })
   325	    return out
   326	
   327	
   328	def roster_child(seat, name):
   329	    """Синтетическая строка ростера: место роздано (seats.json), но НИ ОДНОГО дампа не пришло.
   330	    Только для live-таблицы «кому помочь» — в рубрику/итоги не включать (roster_only)."""
   331	    try:
   332	        seat = int(seat)
   333	    except (TypeError, ValueError):
   334	        pass
   335	    return {'seat': seat, 'name': name or '', 'stage': '—', 'last_seen': None, 'hyp': '—',
   336	            'guessCat': '—', 'fixChosen': '—', 'stuck': 0, 'r1': None, 'r2': None, 'survey': [],
   337	            'klass': 'не открыл ссылку', 'mixed': False, 'restarts': 0, 'broke': False,
   338	            'inv': {}, 'inv_tail': 0, 'lock_fails': 0, 'stuck_last': None, 'cam_drops': 0,
   339	            'cert': False, 'boot_dead': False, 'os': '?', 'mobile': False,
   340	            'fps_min': None, 'fps_med': None, 'stage_min': {}, 'dur_min': 0, 'roster_only': True,
   341	            'sids': []}
   342	
   343	
   344	def split_by_date(raws):
   345	    """Сырые записи → {дата приёма: [записи]}. Один seat в разные дни — РАЗНЫЕ дети:
   346	    dedupe/build_children дат не знают, поэтому многодневный вход режем ДО них (Codex 10.07)."""
   347	    by = {}
   348	    for r in raws:
   349	        t = _parse_iso(r.get('recv'))
   350	        by.setdefault(t.date().isoformat() if t else 'без даты', []).append(r)
   351	    return by
   352	
   353	
   354	def fmt_r(r):
   355	    return f"{r['correct']}/{r['total']}" if r else '—'
   356	
   357	
   358	def fmt_stages(sm):
   359	    return ' · '.join(f'{k} {v}' for k, v in sm.items()) if sm else '—'
   360	
   361	
   362	def fmt_hw(k):
   363	    fps = f"fps {k['fps_min']}–{k['fps_med']}" if k['fps_min'] is not None else 'fps —'
   364	    return (k['os'] + ('·моб' if k['mobile'] else '') + ' · ' + fps
   365	            + (f" · 📷×{k['cam_drops']}" if k['cam_drops'] else ''))
     1	<!doctype html><html lang="ru"><head><meta charset="utf-8">
     2	<meta name="viewport" content="width=device-width,initial-scale=1">
     3	<title>Прототип навигации · Лаборатория тренера ИИ</title>
     4	<style>
     5	/* ===== ЧЕРНОВОЙ макет: тестируем НАВИГАЦИЮ, не вид. Серые заглушки = будущий контент ===== */
     6	:root{--bg:#0b0e14;--card:#10151e;--line:#2a3445;--text:#e8eef7;--muted:#8fa0b8;--ok:#46e08a;--warn:#ffcf5c;--accent:#7aa2ff;--bad:#ff6b8b}
     7	*{box-sizing:border-box}
     8	html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,"Segoe UI",system-ui,sans-serif;user-select:none}
     9	body{display:flex;flex-direction:column;min-height:100vh}
    10	main{flex:1;padding:18px 16px 96px;max-width:760px;margin:0 auto;width:100%}
    11	h1{font-size:22px;margin:6px 0 2px}h2{font-size:18px;margin:14px 0 6px}
    12	p{color:var(--muted);margin:4px 0;line-height:1.45}
    13	button{font:inherit;border:0;border-radius:14px;padding:12px 18px;font-weight:800;cursor:pointer;background:#232c3d;color:var(--text)}
    14	button.ok{background:var(--ok);color:#08331c}
    15	button.ghost{background:transparent;border:2px solid var(--line)}
    16	.screen{display:none}.screen.on{display:block;animation:in .15s ease-out}
    17	@keyframes in{from{opacity:0;transform:translateY(6px)}to{opacity:1}}
    18	/* миссия-виджет */
    19	.mission{background:linear-gradient(135deg,#1b2a4a,#14203a);border:2px solid var(--accent);border-radius:16px;padding:12px 14px;display:flex;gap:12px;align-items:center;margin:10px 0 16px}
    20	.mission .mnum{font-size:26px}
    21	.mission .mtxt b{display:block;font-size:16px}
    22	.mission .mtxt span{color:var(--muted);font-size:13px}
    23	.mission button{margin-left:auto;flex:0 0 auto}
    24	/* плитки хаба */
    25	.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
    26	.tile{background:var(--card);border:2px solid var(--line);border-radius:18px;padding:14px;min-height:110px;cursor:pointer;position:relative;display:flex;flex-direction:column;gap:4px}
    27	.tile:hover{border-color:var(--accent)}
    28	.tile .ti{font-size:30px}.tile b{font-size:15px}.tile span{font-size:12px;color:var(--muted)}
    29	.tile .cnt{position:absolute;top:10px;right:12px;background:var(--accent);color:#0b1220;border-radius:99px;font-size:12px;font-weight:900;padding:2px 8px}
    30	.tile.locked{opacity:.55;cursor:not-allowed;min-height:128px}
    31	.tile.locked span{visibility:hidden}   /* подпись прячем — вместо неё строка «когда откроется» */
    32	.tile.locked::after{content:"🔒 "attr(data-when);position:absolute;inset:auto 12px 12px 12px;font-size:11px;color:var(--warn)}
    33	/* альбом */
    34	.shelf{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:12px;margin:10px 0}
    35	.shelf h3{margin:0 0 8px;font-size:15px}
    36	.cards{display:flex;flex-wrap:wrap;gap:8px}
    37	.crd{width:74px;height:74px;border-radius:10px;background:#182234;border:1px solid var(--line);position:relative;display:flex;align-items:center;justify-content:center;cursor:default}
    38	.crd .x{position:absolute;top:-7px;right:-7px;width:22px;height:22px;border-radius:99px;background:var(--bad);color:#fff;font-size:12px;font-weight:900;border:0;padding:0;line-height:22px;cursor:pointer}
    39	.crd.add{border:2px dashed var(--accent);background:transparent;color:var(--accent);font-size:26px;cursor:pointer}
    40	.crd .rnd{font-size:9px;color:var(--warn);position:absolute;bottom:3px;left:5px}
    41	/* съёмка */
    42	.cambox{background:#151d2c;border:2px dashed var(--line);border-radius:18px;height:270px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;margin:10px 0;position:relative}
    43	.cambox .sil{font-size:84px;opacity:.85}
    44	.cambox .gate{color:var(--ok);font-weight:800;font-size:14px}
    45	.flyrow{display:flex;gap:8px;align-items:center;margin:8px 0}
    46	.tabs{display:flex;gap:8px;margin:8px 0}
    47	.tabs button{border:2px solid var(--line)}
    48	.tabs button.act{border-color:var(--ok);background:#123322}
    49	/* проверка */
    50	.checkcard{background:var(--card);border:2px solid var(--warn);border-radius:16px;padding:16px;text-align:center;margin:10px 0}
    51	/* нижняя навигация */
    52	nav{position:fixed;bottom:0;left:0;right:0;background:#0d1119ee;border-top:1px solid var(--line);display:flex;justify-content:center;gap:4px;padding:8px 6px;backdrop-filter:blur(8px)}
    53	nav button{display:flex;flex-direction:column;align-items:center;gap:2px;background:transparent;border-radius:12px;padding:6px 12px;font-size:11px;font-weight:700;color:var(--muted);min-width:76px}
    54	nav button .ni{font-size:22px}
    55	nav button.act{background:#1b2a4a;color:var(--text)}
    56	nav button.lock{opacity:.45}
    57	nav button .lk{position:absolute;margin:-4px 0 0 26px;font-size:10px}
    58	/* верхняя полоска */
    59	header{display:flex;align-items:center;gap:10px;padding:10px 16px;border-bottom:1px solid var(--line);position:sticky;top:0;background:#0d1119ee;backdrop-filter:blur(8px);z-index:5}
    60	header .stars{margin-left:auto;font-size:14px;letter-spacing:2px}
    61	header .dev{font-size:11px;color:var(--muted)}
    62	.toast{position:fixed;left:50%;top:18%;transform:translateX(-50%);background:#1b2a4a;border:1px solid var(--accent);padding:10px 18px;border-radius:12px;font-weight:800;opacity:0;transition:.2s;pointer-events:none;z-index:50}
    63	.toast.on{opacity:1}
    64	.note{font-size:12px;color:var(--warn)}
    65	.row{display:flex;gap:10px;flex-wrap:wrap;margin:10px 0}
    66	.devbar{position:fixed;top:52px;right:8px;background:#0d1119dd;border:1px solid var(--line);border-radius:12px;padding:8px;font-size:11px;color:var(--muted);z-index:6}
    67	.devbar select{background:#182234;color:var(--text);border:1px solid var(--line);border-radius:8px;font-size:11px;padding:2px}
    68	</style></head><body>
