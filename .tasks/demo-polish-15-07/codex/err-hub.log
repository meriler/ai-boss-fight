   993	/* кнопка ЗАМЕРИТЬ: короткий отсчёт 2-1 (Codex: 3-2-1 медленно при частых замерах) → замер.
   994	   Руки нет в кадре — отсчёт мягко ЖДЁТ (не сбрасывается): меньше обидных пустых замеров. */
   995	function ckShotClick(){
