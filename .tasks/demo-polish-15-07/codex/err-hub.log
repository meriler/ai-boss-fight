/* ---- классификация (отдельный цикл — embed дорог, не каждый rAF) ---- */
let predCache=null, smooth=[];
const LIVE_STATES=new Set(['train','check','game','train-pause','gteach','gcheck','gpause']);
function classifyTick(){
  if(LIVE_STATES.has(state) && (embedder) && (DEMO||cam.readyState>=2)){
    const f=grabFeature(); curFeat=f;
    const p=f?KNN.classify(f):null;
    // temporal smoothing: majority за 5 замеров
    if(p){ smooth.push(p.label); if(smooth.length>5)smooth.shift(); }
    predCache=p;
    drawPeek();
    if(state==='gteach')tickGuidedTeach();
    if(DBG)renderDebug(p);
  }
  setTimeout(classifyTick, 60);
}
let curFeat=null;
function smoothLabel(){ if(!smooth.length)return -1; const c={};smooth.forEach(l=>c[l]=(c[l]||0)+1);let b=-1,bc=-1;for(const l in c)if(c[l]>bc){bc=c[l];b=+l}return b; }
function drawPeek(){ if(!lastPix)return; const t=document.createElement('canvas');t.width=32;t.height=32;t.getContext('2d').putImageData(lastPix,0,0);
  peekCtx.imageSmoothingEnabled=false; peekCtx.clearRect(0,0,32,32); peekCtx.drawImage(t,0,0); }

const THUMBS=[[],[]];   // ImageData 32×32 каждого примера (по классам) — для разгадки «смотри, что ты собрал»

/* ---- Автосейв прогресса (F5-устойчивость, прогон 13.07) --------------------
   Перезагрузка страницы сбрасывала ребёнка на стартовый экран с пустой моделью
   (Настя, прогон). Теперь: на каждой ВЕХЕ урока датасет+результаты снапшотятся в
   localStorage (ключ по месту), а на интро появляется «Продолжить с места».
   Восстановление — только в БЕЗОПАСНЫЕ точки входа (проверка/разгадка/финал),
   state machine не трогаем. Всё лежит локально на устройстве ребёнка (как и
   телеметрия), наружу не уходит; сейв живёт 6 часов. */
/* ключ — ФУНКЦИЯ, не константа: у ребёнка без персональной ссылки seat появляется позже
   (экран выбора места), замороженный ключ смешивал всех безссылочных в один слот ws_save_x (ревью 14.07) */
function saveKey(){ return WS ? ('ws_save_'+(TELE.seat??'x')) : null; }
function _b64(buf){ const u=buf.buffer?new Uint8Array(buf.buffer,buf.byteOffset||0,buf.byteLength):new Uint8Array(buf); let s=''; for(let i=0;i<u.length;i+=4096)s+=String.fromCharCode.apply(null,u.subarray(i,i+4096)); return btoa(s); }
function _unb64(s){ const b=atob(s),u=new Uint8Array(b.length); for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i); return u; }
const SAVE_RANK={r1:1,checked1:2,revealed:3,fixdata:4,final:5};
/* Цикл сейва (Codex R2 14.07): «Поехали» рождает новый cycleId, «Продолжить» усыновляет id снимка.
   Ранг-защита вех действует только ВНУТРИ цикла; слот с чужим cy (вторая вкладка того же места)
   не перезаписывается — чужой final не приезжает поверх свежего r1. SAVE_FRESH гаснет только после
   ПОДТВЕРЖДЁННОЙ записи: неудачная первая запись не возвращает старый ранг в силу. */
let SAVE_FRESH=false, SAVE_CYCLE=null;
function _tsOk(ts){ const age=Date.now()-ts; return Number.isFinite(ts)&&age>-60e3&&age<6*3600e3; }
function saveMilestone(ms){ const key=saveKey(); if(!key||!KNN.ex.length)return; try{
  if(!SAVE_CYCLE)SAVE_CYCLE=Math.random().toString(36).slice(2,10);
  const prev=loadSave();
  if(!SAVE_FRESH&&prev){
    if(prev.cy&&prev.cy!==SAVE_CYCLE)return;               // слот занят другим циклом (другая вкладка) — не трогаем
    if(SAVE_RANK[prev.ms]>SAVE_RANK[ms])ms=prev.ms;        // внутри цикла веха не откатывается (повторная проверка R1)
  }
  const body=JSON.stringify({v:1, cy:SAVE_CYCLE, ts:Date.now(), ms,
    ex:KNN.ex.map(x=>({e:_b64(x.emb),p:_b64(x.pix),l:x.l})),
    counts:[counts[0],counts[1]],
    th:[THUMBS[0],THUMBS[1]].map(a=>a.map(x=>({d:_b64(x.img.data),r:x.round}))),
    g:{res1:GUIDE.res1,res2:GUIDE.res2,guessKey:GUIDE.guessKey,guessCat:GUIDE.guessCat,
       fixChosen:GUIDE.fixChosen,fixTries:GUIDE.fixTries,outcome:GUIDE.outcome}});
  let wrote=false;
  try{ localStorage.setItem(key,body); wrote=true; }
  catch(err){ // ТОЛЬКО при квоте: выкинуть достоверно протухшие v1-сейвы и попробовать ровно ещё раз
    const q=err&&(err.name==='QuotaExceededError'||err.code===22||/quota/i.test(String(err)));
    if(q)try{ for(const k of Object.keys(localStorage)){ if(!k.startsWith('ws_save_')||k===key)continue;
        const raw=localStorage.getItem(k); let dead=false;
        try{ const d=JSON.parse(raw); dead=!!d&&d.v===1&&!_tsOk(d.ts); }catch(_){}
        if(dead&&localStorage.getItem(k)===raw)localStorage.removeItem(k); }   // пере-сверка: слот могла обновить другая вкладка
      localStorage.setItem(key,body); wrote=true; }catch(_){}
  }
  if(wrote)SAVE_FRESH=false;   // флаг «новый цикл» живёт до первой УСПЕШНОЙ записи (Codex R2)
}catch(e){} }
function loadSave(){ const key=saveKey(); if(!key)return null; try{
  const s=JSON.parse(localStorage.getItem(key)||'null');
  if(!s||s.v!==1||!Array.isArray(s.ex)||!s.ex.length||!s.g||!Array.isArray(s.counts))return null;
  if(!_tsOk(s.ts))return null;   // NaN/строка/будущее — не проходят
  return s; }catch(e){ return null; } }
function clearSave(){ const key=saveKey(); if(key)try{localStorage.removeItem(key)}catch(e){} }
function applySave(s){
  // транзакционность (Codex R2): сначала декодируем и проверяем ВСЁ во временные массивы,
  // мутируем runtime только целиком — битый хвост снимка не оставляет полу-применённую модель
  const ex=[], th=[[],[]];
  s.ex.forEach(x=>{ const eb=_unb64(x.e),pb=_unb64(x.p);
    if(!eb.length||eb.length%4||!pb.length||pb.length%4)throw new Error('bad save ex');
    if(!(x.l===0||x.l===1))throw new Error('bad save label');
    ex.push({emb:new Float32Array(eb.buffer), pix:new Float32Array(pb.buffer), l:x.l}); });
  const el0=ex[0].emb.length;
  if(ex.some(x=>x.emb.length!==el0||x.pix.length!==1024))throw new Error('bad save dims');   // pix строго 32×32 (grabFeature)
  for(const x of ex){ for(let i=0;i<x.pix.length;i++)if(!Number.isFinite(x.pix[i]))throw new Error('bad save nan');
    for(let i=0;i<x.emb.length;i++)if(!Number.isFinite(x.emb[i]))throw new Error('bad save nan'); }
  if(!Array.isArray(s.th)||s.th.length!==2)throw new Error('bad save th');
  s.th.forEach((a,c)=>a.forEach(x=>{ const d=_unb64(x.d);
    if(d.length!==4096)throw new Error('bad save thumb');   // строго 32×32×4
    th[c].push({img:new ImageData(new Uint8ClampedArray(d.buffer),32,32),round:x.r}); }));
  const c0=s.counts[0]|0, c1=s.counts[1]|0;
  if(c0<0||c1<0)throw new Error('bad save counts');
  // --- всё проверено, применяем атомарно ---
  KNN.clear(); ex.forEach(x=>KNN.ex.push(x));
  counts[0]=c0; counts[1]=c1;
  THUMBS[0].length=0; THUMBS[1].length=0;
  th.forEach((a,c)=>a.forEach(x=>THUMBS[c].push(x)));
  Object.assign(GUIDE,{res1:s.g.res1,res2:s.g.res2,guessKey:s.g.guessKey,guessCat:s.g.guessCat,
    fixChosen:s.g.fixChosen,fixTries:s.g.fixTries||0,outcome:s.g.outcome});
  if(THUMBS[0].length&&!certFrame){ certFrame=THUMBS[0][0].img; }  // сертификату нужен кадр ладони
}
/* какую веху пишем по событию телеметрии (единая точка — вехи и так идут через TELE.push).
   check_done — только GUIDED-раунды 1/2: свободная проверка лаборатории (round=0) не веха урока (Codex 14.07) */
function trySaveOn(type,data){ if(!WS)return; try{
  if(type==='task_done'&&data&&data.task==='t1b')saveMilestone('r1');
  else if(type==='task_done'&&data&&data.task==='t2b')saveMilestone('fixdata');
  else if(type==='check_done'&&data&&data.guided&&(data.round===1||data.round===2))saveMilestone(data.round===2?'fixdata':'checked1');
  else if(type==='reveal_unlock')saveMilestone('revealed');
  else if(type==='final')saveMilestone('final');
  else if(type==='survey_done')saveMilestone('final');
}catch(e){} }
/* вспышка-«щёлк» на каждый принятый кадр: рестарт CSS-анимации через reflow */
function flashShot(){ const el=$('#shotfx'); el.classList.remove('go'); void el.offsetWidth; el.classList.add('go'); }
function addExample(i,round){ const f=curFeat||grabFeature(); if(!f){showToast('Кадр не готов',700);return false}
  KNN.add(f,i); counts[i]++;
  if(i===0&&lastPix)certFrame=lastPix;   // в сертификат — последняя ЛАДОНЬ (пятерня фотогеничнее кулака, смок 10.07)
  if(lastPix)THUMBS[i].push({img:new ImageData(new Uint8ClampedArray(lastPix.data),32,32),round:round||0});
  TELE.push('sample',{cls:i,round:round||0,hand:lastHand.side!=null?+lastHand.side.toFixed(3):null,n:counts[i]});
  refresh(); updateHint(); SFX.learn(counts[i]); flashShot(); return true;
}

/* ---- бары «на что похоже» ---- */
function updateBars(p){
  if(p===updateBars._p && state===updateBars._s && KNN.ex.length===updateBars._n)return;   // без изменений — не дёргаем DOM
  updateBars._p=p; updateBars._s=state; updateBars._n=KNN.ex.length;
  const ah=$('#aihead');
  if(state==='game'||state==='gameover'){ ah.style.display='none';
    if(!p){barsEl.innerHTML='';return}
  if(!KNN.ex.length){barsEl.innerHTML='<div class="bar"><span class="l" style="flex:1;color:var(--warn)">🤖 ИИ пока пустой — научи его (держи кнопку 👇)</span></div>';return}
  if(p&&p.far){barsEl.innerHTML='<div class="bar"><span class="l" style="flex:1;color:var(--warn)">🤔 ИИ видит что-то непохожее на примеры</span></div>';return}
  const conf=p?p.confidences:{},top=p?p.label:-1,tv=p?(p.vote||0):0;
  barsEl.innerHTML=CLASSES.map((c,i)=>{const v=Math.round((conf[i]||0)*100);return `<div class="bar${i===top&&tv>=.6?' top':''}"><span class="l">${c.emoji} похоже на: ${c.name}</span><span class="t"><i style="width:${v}%"></i></span><span class="p">${v}%</span></div>`}).join('');
}

/* ====================== УРОК (guided-флоу): калибровка → сбор с гейтом → поломка → починка ====================== */
const SCREENS=['intro','loading','seat','hypo','guess','lock','reveal','fixpick','final','survey','result'];
function showScreen(id){
  SCREENS.forEach(s=>{const e=$('#'+s);e.classList.toggle('hidden',s!==id);e.style.pointerEvents='';});
  // анти-click-through: 350мс глушим ввод на свежем экране — второй клик дабл-тапа ребёнка
  // не должен нажать кнопку, оказавшуюся под пальцем (случайный guess/lockNext = грязный замер)
  if(id){const el=$('#'+id);el.style.pointerEvents='none';setTimeout(()=>{el.style.pointerEvents='';},350);}
}
const guideEl=$('#guide'),gstepEl=$('#gstep'),gtaskEl=$('#gtask'),gdotsEl=$('#gdots'),ggateEl=$('#ggate');

const GUIDE={
  on:false, task:null, gateMs:0, lastAdd:0,
  guess:null, res1:null, res2:null, probeRetried:false, fixTries:0, outcome:null,
  // честный замер (v4): probe хранится между экранами гипотеза→варианты; выбор варианта живёт
  // в guessKey/guessCat до разгадки (guess-событие пушится один раз, при клике); fixChosen:
  // 'self' = сам выбрал починку / 'shown' = показали после 2 ошибок (ось «сам починил» рубрики)
  probe:null, guessKey:null, guessCat:null, fixAttempts:0, fixChosen:null, lockFails:0,
};
const TASKS={
  t1a:{cls:0,gate:'big',  need:CFG.needR1,round:1,step:'ТРЕНИРОВКА · 1 из 2',
       txt:'<span class="em">✋</span>Покажи ладонь —<br>совпади размером с контуром!'},
  t1b:{cls:1,gate:'small',need:CFG.needR1,round:1,step:'ТРЕНИРОВКА · 2 из 2',
       txt:'<span class="em">✊</span>Теперь кулак — отодвинь руку,<br>чтобы стал маленьким, как контур'},
  t2a:{cls:0,gate:'small',need:CFG.needR2,round:2,step:'ПОЧИНКА · 1 из 2',
       txt:'<span class="em">✋</span>Добавь МАЛЕНЬКУЮ ладонь —<br>издалека, как контур'},
  t2b:{cls:1,gate:'big',  need:CFG.needR2,round:2,step:'ПОЧИНКА · 2 из 2',
       txt:'<span class="em">✊</span>И БОЛЬШОЙ кулак —<br>поближе, с контур размером!'},
};
function enterGuide(){ GUIDE.on=true; TELE.push('guide_start');
  // номер места из персональной ссылки (?seat=N, бот рассылает каждому свою) — детей цифрами не грузим;
  // экран выбора остаётся fallback'ом для ссылок без параметра (запасной ребёнок, опоздавший)
  const qs=parseInt(QP.get('seat'),10);
  if(WS&&TELE.seat==null&&qs>=1&&qs<=99)TELE.seat=qs;   // страховка (ранняя инициализация в блоке TELE)
  // «seat известен» (ранняя идентификация) ≠ «seat зарегистрирован в уроке» — событие шлём один раз тут
  if(WS&&TELE.seat!=null&&!TELE._seatReg){ TELE._seatReg=true; TELE.push('seat',{n:TELE.seat,via:'link'}); try{localStorage.setItem('ws_seat',TELE.seat)}catch(e){} }
  if(WS && TELE.seat==null) showSeatScreen(); else if(RESUME) resumeFlow(); else startFirstTask(); }
function startFirstTask(){ startTask('t1a'); }
function showSeatScreen(){ state='gpause'; showScreen('seat');
  const g=$('#seatgrid'); if(!g.children.length){
    for(let n=1;n<=15;n++){ const b=document.createElement('button'); b.className='ghost'; b.textContent=n;
      b.onclick=()=>{ TELE.seat=n; TELE.push('seat',{n}); try{localStorage.setItem('ws_seat',n)}catch(e){}
        try{ if(localStorage.getItem('ws_unlocked_'+n))GUIDE.unlocked=true; }catch(e){}   // ключи по месту — перечитать ПОСЛЕ выбора (ревью 14.07)
        showScreen(null); if(RESUME&&loadSave())resumeFlow(); else startFirstTask(); }; g.appendChild(b); } } }
function stepCard({big,title,text,btn,onGo,album,exit}){
  state='gpause'; showScreen(null); guideEl.classList.add('hidden'); checkui.classList.add('hidden');
  $('#scBig').textContent=big; $('#scTitle').innerHTML=title; $('#scText').innerHTML=text||'';
  $('#scGo').textContent=(btn||'▶️ Начали!')+' (пробел)';
  $('#scGo').onclick=()=>{ $('#stepcard').classList.add('hidden'); onGo(); };
  // «альбом виден там, где о нём говорим» (фидбек Алексея 14.07): карточки починки показывают сам альбом
  $('#scAlbum').classList.toggle('hidden',!album);
  $('#scExit').classList.toggle('hidden',!exit);
  // две карточки подряд («собрано» → интро задачи): дабл-тап не должен проскочить вторую
  $('#scGo').disabled=true; setTimeout(()=>{$('#scGo').disabled=false;},350);
  $('#stepcard').classList.remove('hidden');
}
const TASK_INTRO={
  t1a:{big:'✋',title:'Научим ИИ ладони!',text:'Показывай ладонь так, чтобы она совпала с контуром на экране. ИИ сам сфотографирует 6 штук.'},
  t1b:{big:'✊',title:'Теперь кулаки!',text:'Сожми кулак и отодвинь руку, чтобы он стал маленьким, как контур. Ещё 6 фото.'},
  // «шевели рукой» — только в починке: в R1 однообразие кадров НАМЕРЕННОЕ (усиливает ловушку)
  // «старые примеры остаются» — Настя на прогоне 13.07 путалась, участвует ли прежний альбом в починке
  t2a:{big:'✋',title:'Чиним: маленькие ладони',text:'Покажи ИИ то, чего он не видел: ладонь ИЗДАЛЕКА, маленькую как контур. Чуть меняй наклон между кадрами. 3 фото.<br><br><span style="color:var(--warn)">📒 Старые примеры остаются в альбоме — ты ДОБАВЛЯЕШЬ новые.</span>'},
  t2b:{big:'✊',title:'И большие кулаки',text:'И наоборот: кулак БЛИЗКО, большой как контур. Тоже чуть по-разному. Ещё 3 фото.<br><br><span style="color:var(--warn)">📒 Старые примеры тоже в альбоме — он только растёт.</span>'},
};
function startTask(key){
  const intro=TASK_INTRO[key];
  const fix=key==='t2a'||key==='t2b';
  // починка: альбом открывается кнопкой (не словами); дообучение ПОСЛЕ финала — с выходом назад
  stepCard({...intro,album:fix,exit:fix&&!!GUIDE.outcome,btn:'▶️ Начали!',onGo:()=>{
    const t=TASKS[key]; GUIDE.task={...t,key,got:0}; GUIDE.gateMs=0; GUIDE.lastAdd=0;
    state='gteach';
    guideEl.classList.remove('hidden'); topEl.classList.add('hidden'); bottom.classList.add('hidden');
    gstepEl.textContent=t.step; gtaskEl.innerHTML=t.txt;
    gdotsEl.innerHTML=Array.from({length:t.need},()=>'<i></i>').join('');
    ggateEl.textContent=''; TELE.push('task_start',{task:key});
  }});
}
function tickGuidedTeach(){
  const T=GUIDE.task; if(!T)return;
  if(camWasDown){GUIDE.gateMs=0;return;}   // камера отпала — замираем
  const sizeOk=gateOk(T.gate,null,T.cls), form=formOkFor(T.cls);
  const ok=sizeOk&&form, now=performance.now();
  const txt=sizeOk&&!form ? formHint(T.cls) : gateHint(T.gate,null,T.cls);
  if(txt!==ggateEl.textContent && (now-(tickGuidedTeach._ts||0)>600)){   // троттл: на границе порога текст не стробит
    ggateEl.textContent=txt; ggateEl.className=ok?'ok':'no'; tickGuidedTeach._ts=now; }
  if(ok){GUIDE.gateMs+=60;GUIDE.stuckMs=0;} else {GUIDE.gateMs=0;GUIDE.stuckMs=(GUIDE.stuckMs||0)+60;}
  // гейт не проходит очень долго → подсказка позвать ведущего (и след в телеметрии)
  if(GUIDE.stuckMs>25000){GUIDE.stuckMs=0;TELE.push('gate_stuck',{task:T.key});showToast('Не выходит? Позови ведущего 🙋',2000);}
  if(GUIDE.gateMs>=CFG.gateHoldMs && now-GUIDE.lastAdd>=CFG.sampleCdMs){
    GUIDE.lastAdd=now;
    if(addExample(T.cls,T.round)){
      T.got++;                                   // «щёлк» кадра — в addExample (прогон 13.07: темп 900мс требует явной отсечки)
      [...gdotsEl.children].forEach((d,i)=>d.classList.toggle('on',i<T.got));
      if(T.got>=T.need){ GUIDE.task=null; TELE.push('task_done',{task:T.key});
        state='gpause'; nextAfterTask(T.key); }
    }
  }
}
function nextAfterTask(key){
  guideEl.classList.add('hidden');
  if(key==='t1a') stepCard({big:'✅',title:'6 ладоней собрано!',text:'ИИ их запомнил.',btn:'Дальше →',onGo:()=>startTask('t1b')});
  else if(key==='t1b') stepCard({big:'🎓',title:'ИИ обучен!',text:'6 ладоней и 6 кулаков. Теперь проверим, чему он на самом деле научился. Показывай жесты и жми «ЗАМЕРИТЬ».',btn:'🔍 Проверить ИИ',onGo:()=>startGuidedCheck(1)});
  else if(key==='t2a') startTask('t2b');
  else if(key==='t2b') stepCard({big:'🔧',title:'Починка готова!',text:'Ты добавил ИИ маленькие ладони и большие кулаки. Загляни в альбом — старые и новые примеры вместе. Проверим ещё раз?',album:true,exit:!!GUIDE.outcome,btn:'🔍 Проверить',onGo:()=>startGuidedCheck(2)});
}

/* ====================== ПРОВЕРКА (общая для урока и лаборатории) ====================== */
const CARDS_PER_CLASS=4;
const HOLD=900,MEASURE_TAIL=780,COUNT_STEP=700;   // замер короткий: почти весь идёт в samples
let CHK=null;
function shuffledCards(){const a=[];for(let c=0;c<CLASSES.length;c++)for(let n=0;n<CARDS_PER_CLASS;n++)a.push({cls:c});
  for(let i=a.length-1;i>0;i--){const j=(Math.random()*(i+1))|0;[a[i],a[j]]=[a[j],a[i]]}
  return a;}
// карточки урока. R1: две «как учили» (доверие) + пробник — ✋ ИЗДАЛЕКА (надёжное направление поломки).
// R2: те же + оба «наоборот» — теперь должны узнаваться.
function guidedCards(round){
  return round===1
    ? [{cls:0,gate:'big'},{cls:1,gate:'small'},{cls:0,gate:'small',probe:true}]
    : [{cls:0,gate:'big'},{cls:1,gate:'small'},{cls:0,gate:'small',probe:true},{cls:1,gate:'big',probe:true}];
}
function cardTitle(card){
  const c=CLASSES[card.cls], fem=card.cls===0;   // род: ладонь БОЛЬШАЯ, кулак БОЛЬШОЙ (смок 09.07)
  if(!card.gate)return `<span class="em">${c.emoji}</span>${c.name} — в рамке`;
  return card.gate==='big'
    ? `<span class="em">${c.emoji}</span>${c.name} — ${fem?'БОЛЬШАЯ':'БОЛЬШОЙ'}, как контур`
    : `<span class="em">${c.emoji}</span>${c.name} — ${fem?'маленькая':'маленький'}, как контур`;
}
function ckButtons(mode){ // 'shot' | 'retry' | 'next' | 'why' | none
  $('#ckShot').classList.toggle('hidden',mode!=='shot');
  $('#ckRetry').classList.toggle('hidden',mode!=='retry');
  $('#ckNext').classList.toggle('hidden',mode!=='next'&&mode!=='why');
  // textContent — ТОЛЬКО при изменении: ckButtons зовётся каждый кадр из renderCheckUI, а замена
  // текстового узла под курсором между mousedown/mouseup убивает click в WebKit — Safari-баг смока 10.07
  const t=mode==='why'?'Почему?! 🤔 (пробел)':mode==='next'?'Дальше → (пробел)':null;
  if(t&&$('#ckNext').textContent!==t)$('#ckNext').textContent=t;
}
function startCheck(){ // лаборатория (свободный режим)
  state='check';
  CHK={cards:shuffledCards(),idx:0,phase:'ready',t0:performance.now(),samples:[],lastSample:0,results:[],guided:false};
  $('#result').classList.add('hidden'); bottom.classList.add('hidden'); zoneEl.classList.add('hidden'); checkui.classList.remove('hidden');
  $('#ckverdict').textContent=''; ckButtons('shot');
  $('#ckverdict').textContent=''; ckButtons('shot');
  $('#ckExit').classList.remove('hidden');   // свободная серия — не тоннель, выйти можно всегда
}
function startGuidedCheck(round){
  state='gcheck'; showScreen(null); guideEl.classList.add('hidden');
  CHK={cards:guidedCards(round),idx:0,phase:'ready',t0:performance.now(),samples:[],lastSample:0,results:[],guided:true,round,gateMs:0};
  bottom.classList.add('hidden'); topEl.classList.remove('hidden'); checkui.classList.remove('hidden');
  $('#ckverdict').textContent=''; ckButtons('shot');
  // урок ведёт сам — выхода нет; НО опциональное дообучение после финала (outcome есть) — не тоннель (фидбек 14.07)
  const optional=round===2&&!!GUIDE.outcome;
  $('#ckExit').textContent=optional?'✖ Хватит — к финалу':'← В лабораторию';
  $('#ckExit').classList.toggle('hidden',!optional);
}
/* кнопка ЗАМЕРИТЬ: короткий отсчёт 2-1 (Codex: 3-2-1 медленно при частых замерах) → замер.
   Руки нет в кадре — отсчёт мягко ЖДЁТ (не сбрасывается): меньше обидных пустых замеров. */
function ckShotClick(){
  if(!CHK||CHK.phase!=='ready')return;
  CHK.phase='count'; CHK.count=2; CHK.t0=performance.now(); ckButtons(null);
  $('#ckcount3').style.display='block'; $('#ckcount3').textContent='2'; SFX.learn(1);
}
function ckRetryClick(){ if(!CHK)return; CHK.phase='ready'; $('#ckverdict').textContent=''; $('#ckhint').textContent=''; ckButtons('shot'); }
function ckNextClick(){
  if(!CHK||CHK.phase!=='verdict')return;   // двойной клик не должен пропустить карточку
  CHK.idx++;
  if(CHK.idx>=CHK.cards.length){ finishCheck(); return; }
  CHK.phase='ready'; $('#ckverdict').textContent=''; $('#ckhint').textContent=''; ckButtons('shot');
}
function judgeCard(card){
  const s=CHK.samples;
  // замер невалиден (не считается попыткой): руки не было / не тот размер / не тот жест
  const seen=s.filter(x=>x.hand).length, sized=s.filter(x=>x.hand&&x.size).length, formed=s.filter(x=>x.hand&&x.form).length;
  CHK.invalidN=(CHK.invalidN||0);
  const esc=CHK.invalidN>=2 ? ' Если не выходит — позови ведущего 🙋' : '';
  if(!s.length||seen<s.length*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg='🚫 Не увидел руку — попробуем ещё раз.'+esc; TELE.push('shot_invalid',{why:'nohand'}); return; }
  if(CHK.guided&&sized<seen*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg='📏 Рука не того размера — совпади с контуром и замерь снова.'+esc; TELE.push('shot_invalid',{why:'size'}); return; }
  if(CHK.guided&&formed<seen*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg=(card.cls===0?'Это точно ладонь? 🙂 Раскрой пальцы':'Это точно кулак? 🙂 Сожми покрепче')+' — и замерь снова.'+esc; TELE.push('shot_invalid',{why:'form'}); return; }
  CHK.invalidN=0;
  const valid=s.filter(x=>x.label!=null&&!x.far);
  let verdict,got=null;
  if(!valid.length) verdict='nohand';
  else{ const cnt={}; valid.forEach(x=>cnt[x.label]=(cnt[x.label]||0)+1);
    let mj=-1,mc=-1; for(const l in cnt){if(cnt[l]>mc){mc=cnt[l];mj=+l}}
    const frac=mc/valid.length;
    if(frac<0.6){verdict='wavered';got=mj;}
    else if(mj===card.cls)verdict='correct';
    else{verdict='confused';got=mj;}
  }
  CHK.results.push({cls:card.cls,verdict,got});
  if(card.probe&&lastPix)GUIDE.probeShot=new ImageData(new Uint8ClampedArray(lastPix.data),32,32);   // стоп-кадр для «почему»
  CHK.phase='verdict';
  TELE.push('card',{round:CHK.round||0,cls:card.cls,gate:card.gate||null,probe:!!card.probe,verdict,got,
    hand:lastHand.side!=null?+lastHand.side.toFixed(3):null,
    top:predCache?.top||null});                       // разбивка веток соседей — для замера ставки
  if(verdict==='correct')SFX.ding();else SFX.buzz();
}
function tickCheck(now){
  if(!CHK)return; const card=CHK.cards[CHK.idx], el=now-CHK.t0;
  if(camWasDown){if(CHK.phase==='count'||CHK.phase==='hold'){CHK.phase='ready';ckButtons('shot');$('#ckcount3').style.display='none';}return;}
  if(CHK.phase==='count'){
    if(!lastHand.ok){ CHK.t0=now-(2-CHK.count)*COUNT_STEP; $('#ckcount3').textContent='🖐'; }   // ждём руку, счёт на паузе
    else{
      const c=2-Math.floor(el/COUNT_STEP);
      if(String(c)!==$('#ckcount3').textContent&&c>0){CHK.count=c;$('#ckcount3').textContent=c;SFX.learn(4-c);}
      if(el>=2*COUNT_STEP){ $('#ckcount3').style.display='none';
        CHK.phase='hold'; CHK.t0=now; CHK.samples=[]; CHK.lastSample=0; SFX.ding(); }
    }
  }
  else if(CHK.phase==='hold'){
    if(el>=HOLD-MEASURE_TAIL && now-CHK.lastSample>=80){ CHK.lastSample=now;
      CHK.samples.push({label:predCache?predCache.label:null, far:predCache?predCache.far:true,
        hand:lastHand.ok, size:card.gate?gateOk(card.gate,null,card.cls):true, form:formOkFor(card.cls)}); }
    if(el>=HOLD){ judgeCard(card); CHK.t0=now; }
  }
  renderCheckUI(card,now);
}
function renderCheckUI(card,now){
  const el=now-CHK.t0;
  $('#ckround').textContent=CHK.guided?(CHK.round===1?'🔍 Проверка ИИ':'🔍 Проверка после починки'):'🔍 Проверка ИИ';
  $('#ckcount').textContent=`замер ${Math.min(CHK.idx+1,CHK.cards.length)} из ${CHK.cards.length}`;
  if(CHK.phase==='ready'){
    $('#cktarget').innerHTML=cardTitle(card);
    $('#ckbar').style.width='0%'; $('#ckverdict').textContent='';
    // живая подсказка размера ЕЩЁ ДО нажатия: вплотную к камере детектор слепнет, а без подсказки
    // ребёнок не понимает, чего от него ждут (смок 09.07: кулак во весь кадр)
    const gh=CHK.guided&&card.gate&&lastHand.ok&&!gateOk(card.gate,null,card.cls)?gateHint(card.gate,null,card.cls):null;
    $('#ckhint').textContent=gh||'жми кнопку или ПРОБЕЛ — счёт подождёт твою руку';
  } else if(CHK.phase==='count'){
    $('#cktarget').innerHTML=cardTitle(card);
    $('#ckhint').textContent=CHK.guided&&card.gate?gateHint(card.gate,null,card.cls):'';
  } else if(CHK.phase==='hold'){
    $('#cktarget').innerHTML=cardTitle(card);
    $('#ckbar').style.width=Math.min(100,el/HOLD*100)+'%'; $('#ckbar').style.background='var(--warn)';
    $('#ckverdict').style.color='var(--warn)'; $('#ckverdict').textContent='📸 замеряю…'; $('#ckhint').textContent='держи так!';
  } else if(CHK.phase==='invalid'){
    $('#ckbar').style.width='0%';
    $('#ckverdict').style.color='var(--warn)'; $('#ckverdict').textContent='🤳 Замер не получился';
    $('#ckhint').textContent=CHK.invalidMsg||''; ckButtons('retry');
  } else if(CHK.phase==='verdict'){
    const r=CHK.results[CHK.idx]; $('#ckbar').style.width='100%';
    const isProbeMiss=CHK.guided&&CHK.round===1&&card.probe&&r.verdict!=='correct';
    if(r.verdict==='correct'){$('#ckverdict').style.color='var(--ok)';$('#ckverdict').textContent='✅ Верно!';$('#ckhint').textContent='';}
    else if(r.verdict==='nohand'){$('#ckverdict').style.color='var(--warn)';$('#ckverdict').textContent='🚫 не разобрал кадр';$('#ckhint').textContent='';}
    else if(r.verdict==='wavered'){$('#ckverdict').style.color='var(--warn)';$('#ckverdict').textContent='😵 ИИ заметался — не смог решить!';
      $('#ckhint').textContent=isProbeMiss?`а ты показывал ${CLASSES[card.cls].emoji} ${CLASSES[card.cls].name}…`:'';}
    else{$('#ckverdict').style.color='var(--bad)';$('#ckverdict').textContent=`❌ ИИ сказал: ${CLASSES[r.got].emoji} ${CLASSES[r.got].name}!`;
      $('#ckhint').textContent=isProbeMiss?`а ты показывал ${CLASSES[card.cls].emoji} ${CLASSES[card.cls].name}…`:'';}
    ckButtons(isProbeMiss?'why':'next');
  }
}
function finishCheck(){
  checkui.classList.add('hidden');
  const pc=[{correct:0,confused:0,nohand:0,wavered:0,total:0},{correct:0,confused:0,nohand:0,wavered:0,total:0}];
  for(const r of CHK.results){pc[r.cls].total++;pc[r.cls][r.verdict]++;}
  const c0=pc[0].correct,c1=pc[1].correct,totalCorrect=c0+c1,totalCards=CHK.results.length;
  TELE.push('check_done',{round:CHK.round||0,guided:CHK.guided,correct:totalCorrect,total:totalCards});
  if(CHK.guided){ finishGuidedCheck(totalCorrect,totalCards); return; }
  state='train-pause';
  const outcome = totalCorrect>=Math.ceil(totalCards*0.8) ? 'strong' : totalCorrect>=Math.ceil(totalCards*0.6) ? 'ok' : 'raw';
  provenTier = outcome==='strong'?2 : outcome==='ok'?1 : 0;
  showResult({pc,totalCorrect,totalCards,outcome});
}

/* ---- развилки урока после проверки ---- */
function finishGuidedCheck(correct,total){
  state='gpause'; topEl.classList.add('hidden');
  if(CHK.round===1){
    GUIDE.res1={correct,total};
    const probe=CHK.results[CHK.results.length-1];    // пробник ✋ ИЗДАЛЕКА — всегда последняя карточка R1
    if(probe.verdict==='nohand'){                     // редкость: невалидные замеры ловятся раньше
      TELE.push('inconclusive'); GUIDE.outcome='inconclusive'; showFinal(); return;
    }
    if(probe.verdict==='correct'){                    // ИИ не обманулся — редкий честный путь
      TELE.push('no_break'); GUIDE.outcome='no_break'; showFinal(); return;
    }
    TELE.push('break_shown',{verdict:probe.verdict,got:probe.got});
    if(WS)showHypoScreen(probe); else showGuessScreen(probe);   // ws: сперва СВОЯ гипотеза, до всех подсказок
  } else {
    GUIDE.res2={correct,total};
    if(correct>=3||GUIDE.fixTries>=1){ GUIDE.outcome=correct>=3?'fixed':'partial'; showFinal(); }
    else{ GUIDE.fixTries++; TELE.push('fix_retry');
      saveMilestone('fixdata');   // пере-снимок с актуальными res2/fixTries: ранний check_done их не видел (Codex R2 п.6)
      // повторная починка идёт МИМО выбора (уже выбирал) — вернуть t2a нейтральный интро-текст
      stepCard({big:'🤔',title:'ИИ ещё путается!',text:'Так бывает. Добавим ему ещё немного разных примеров — и проверим снова.',album:true,btn:'🔧 Чинить дальше',onGo:()=>{Object.assign(TASK_INTRO.t2a,T2A_NEUTRAL);startTask('t2a');}}); }
  }
}
function recommend(pc,outcome){
  const recs=[];
  if(outcome!=='strong'){
    recs.push('ИИ знает только то, что ты ему показал. Если все примеры похожи — он цепляется за случайное (размер, место, фон).');
    recs.push('Почини данными: покажи каждый жест ПО-РАЗНОМУ — близко, далеко, под углом.');
    return recs;
  }
  const mn=Math.min(counts[0],counts[1]),mx=Math.max(counts[0],counts[1]);
  if(mx>=mn*2+2){const less=counts[0]<counts[1]?0:1;recs.push(`Перекос: ${CLASSES[0].emoji} ${counts[0]} · ${CLASSES[1].emoji} ${counts[1]}. Добери ${CLASSES[less].emoji}.`);}
  for(let c=0;c<2;c++){ if(pc[c].confused>=2)recs.push(`ИИ путал ${CLASSES[c].emoji} ${CLASSES[c].name} с ${CLASSES[1-c].emoji}. Добери ${CLASSES[c].emoji} в разных местах и с разным фоном.`); }
  if(!recs.length && outcome!=='strong')recs.push('Добери по 6–8 РАЗНЫХ примеров каждого: меняй место, расстояние, наклон, фон.');

