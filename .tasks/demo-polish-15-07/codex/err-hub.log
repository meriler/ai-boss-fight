  1712	/* Восстановление в безопасную точку. Вызывается ВМЕСТО startFirstTask при RESUME. */
  1713	function resumeFlow(){
  1714	  const s=loadSave();
  1715	  if(!s){ startFirstTask(); return; }
  1716	  // битый сейв не должен ронять boot() в «❌ Не загрузилось» с вечным Повторить (ревью 14.07)
