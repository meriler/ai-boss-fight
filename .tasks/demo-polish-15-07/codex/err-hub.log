  1007	function judgeCard(card){
  1008	  const s=CHK.samples;
  1009	  // замер невалиден (не считается попыткой): руки не было / не тот размер / не тот жест
  1010	  const seen=s.filter(x=>x.hand).length, sized=s.filter(x=>x.hand&&x.size).length, formed=s.filter(x=>x.hand&&x.form).length;
  1011	  CHK.invalidN=(CHK.invalidN||0);
  1012	  const esc=CHK.invalidN>=2 ? ' Если не выходит — позови ведущего 🙋' : '';
  1013	  if(!s.length||seen<s.length*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg='🚫 Не увидел руку — попробуем ещё раз.'+esc; TELE.push('shot_invalid',{why:'nohand'}); return; }
  1014	  if(CHK.guided&&sized<seen*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg='📏 Рука не того размера — совпади с контуром и замерь снова.'+esc; TELE.push('shot_invalid',{why:'size'}); return; }
  1015	  if(CHK.guided&&formed<seen*0.5){ CHK.phase='invalid'; CHK.invalidN++; CHK.invalidMsg=(card.cls===0?'Это точно ладонь? 🙂 Раскрой пальцы':'Это точно кулак? 🙂 Сожми покрепче')+' — и замерь снова.'+esc; TELE.push('shot_invalid',{why:'form'}); return; }
  1016	  CHK.invalidN=0;
  1017	  const valid=s.filter(x=>x.label!=null&&!x.far);
  1018	  let verdict,got=null;
  1019	  if(!valid.length) verdict='nohand';
  1020	  else{ const cnt={}; valid.forEach(x=>cnt[x.label]=(cnt[x.label]||0)+1);
  1021	    let mj=-1,mc=-1; for(const l in cnt){if(cnt[l]>mc){mc=cnt[l];mj=+l}}
  1022	    const frac=mc/valid.length;
  1023	    if(frac<0.6){verdict='wavered';got=mj;}
  1024	    else if(mj===card.cls)verdict='correct';
  1025	    else{verdict='confused';got=mj;}
  1026	  }
  1027	  CHK.results.push({cls:card.cls,verdict,got});
  1028	  if(card.probe&&lastPix)GUIDE.probeShot=new ImageData(new Uint8ClampedArray(lastPix.data),32,32);   // стоп-кадр для «почему»
  1029	  CHK.phase='verdict';
  1030	  TELE.push('card',{round:CHK.round||0,cls:card.cls,gate:card.gate||null,probe:!!card.probe,verdict,got,
  1031	    hand:lastHand.side!=null?+lastHand.side.toFixed(3):null,
  1032	    top:predCache?.top||null});                       // разбивка веток соседей — для замера ставки
  1033	  if(verdict==='correct')SFX.ding();else SFX.buzz();
  1034	}
  1035	function tickCheck(now){
  1036	  if(!CHK)return; const card=CHK.cards[CHK.idx], el=now-CHK.t0;
  1037	  if(camWasDown){if(CHK.phase==='count'||CHK.phase==='hold'){CHK.phase='ready';ckButtons('shot');$('#ckcount3').style.display='none';}return;}
  1038	  if(CHK.phase==='count'){
  1039	    if(!lastHand.ok){ CHK.t0=now-(2-CHK.count)*COUNT_STEP; $('#ckcount3').textContent='🖐'; }   // ждём руку, счёт на паузе
  1040	    else{
  1041	      const c=2-Math.floor(el/COUNT_STEP);
  1042	      if(String(c)!==$('#ckcount3').textContent&&c>0){CHK.count=c;$('#ckcount3').textContent=c;SFX.learn(4-c);}
  1043	      if(el>=2*COUNT_STEP){ $('#ckcount3').style.display='none';
  1044	        CHK.phase='hold'; CHK.t0=now; CHK.samples=[]; CHK.lastSample=0; SFX.ding(); }
  1045	    }
  1046	  }
  1047	  else if(CHK.phase==='hold'){
  1048	    if(el>=HOLD-MEASURE_TAIL && now-CHK.lastSample>=80){ CHK.lastSample=now;
  1049	      CHK.samples.push({label:predCache?predCache.label:null, far:predCache?predCache.far:true,
  1050	        hand:lastHand.ok, size:card.gate?gateOk(card.gate,null,card.cls):true, form:formOkFor(card.cls)}); }
  1051	    if(el>=HOLD){ judgeCard(card); CHK.t0=now; }
  1052	  }
  1053	  renderCheckUI(card,now);
  1054	}
  1055	function renderCheckUI(card,now){
