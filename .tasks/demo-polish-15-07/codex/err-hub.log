   969	  $('#ckRetry').classList.toggle('hidden',mode!=='retry');
   970	  $('#ckNext').classList.toggle('hidden',mode!=='next'&&mode!=='why');
   971	  // textContent — ТОЛЬКО при изменении: ckButtons зовётся каждый кадр из renderCheckUI, а замена
   972	  // текстового узла под курсором между mousedown/mouseup убивает click в WebKit — Safari-баг смока 10.07
   973	  const t=mode==='why'?'Почему?! 🤔 (пробел)':mode==='next'?'Дальше → (пробел)':null;
   974	  if(t&&$('#ckNext').textContent!==t)$('#ckNext').textContent=t;
