   175	def stage_times(events):
   176	    """Минуты на фазах урока (по главной сессии). Отрицательные/битые дельты пропускаются."""
   177	    out = {}
   178	    for name, a, b in _PHASES:
   179	        ta, tb = _first_t(events, a), _first_t(events, b)
   180	        if ta is not None and tb is not None and tb > ta:
   181	            out[name] = round((tb - ta) / 60000, 1)
   182	    return out
