   782	    if(!eb.length||eb.length%4||!pb.length||pb.length%4)throw new Error('bad save ex');
   783	    if(!(x.l===0||x.l===1))throw new Error('bad save label');
   784	    ex.push({emb:new Float32Array(eb.buffer), pix:new Float32Array(pb.buffer), l:x.l}); });
   785	  const el0=ex[0].emb.length;
   786	  if(ex.some(x=>x.emb.length!==el0||x.pix.length!==1024))throw new Error('bad save dims');   // pix строго 32×32 (grabFeature)
   787	  for(const x of ex){ for(let i=0;i<x.pix.length;i++)if(!Number.isFinite(x.pix[i]))throw new Error('bad save nan');
   788	    for(let i=0;i<x.emb.length;i++)if(!Number.isFinite(x.emb[i]))throw new Error('bad save nan'); }
