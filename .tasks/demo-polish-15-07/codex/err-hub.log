let lastHand={ok:false,side:null,box:null};   // side = max(ширина,высота) bbox кисти, доля кадра 0..1
let lastBigTs=0;
// визуальная стабилизация: цвет/статус меняем после ~3 согласных тиков, рамку руки сглаживаем (не дёргается)
let _gvis={val:false,cand:false,n:0}, _sbox=null;
function gateOkStable(gate,cls){
