   152	<script>
   153	/* ====== фейковое состояние: только для теста навигации ====== */
   154	const S={
   155	  stage:0,             // индекс этапа урока (см. STAGES)
   156	  cls:0, cards:[[],[]],// альбом: карточки-заглушки {big:bool}
   157	  unlocked:new Set(['hub','mission']),  // открытые зоны
   158	};
   159	const STAGES=[
   160	 {key:'m1',   title:'научи ИИ ладоням',        sub:'Сними 6 больших ладоней',        opens:['train'],       ico:'✋'},
   161	 {key:'m2',   title:'теперь кулаки',           sub:'Сними 6 маленьких кулаков',      opens:['album'],       ico:'✊'},
   162	 {key:'m3',   title:'экзамен для ИИ',          sub:'3 проверки на полигоне',         opens:['check'],       ico:'🔍'},
