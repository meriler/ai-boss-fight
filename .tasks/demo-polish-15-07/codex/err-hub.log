# slides-work — итеративная проработка презентации воркшопа (ночь 14.07)

Процесс (ТЗ Алексея, 14.07 ~01:00): структура → план послайдово (содержимое + закадровый текст Игоря)
→ Codex-ревью → правка → субагенты-критики → Codex → … до 10/10 обоих → сборка слайдов →
итеративная критика скриншотов до 10/10. Каждая итерация — отдельный файл здесь.

Файлы:
- 00-структура-v1.md — укрупнённая структура занятия и роль слайдов в каждом блоке
- 01-план-v1.md — послайдовый план v1 (слайд: визуал/тезис + закадровый план Игоря)
- 02-codex-r1.md — ответ Codex по плану v1 → 03-план-v2.md → 04-критика-субагентов.md → 05-план-v3.md …
- NN-* — далее по циклу; последний план = канон для сборки
- images/ — сгенерированные картинки (image-bridge)
- score.md — текущие оценки (Codex / Клава), стоп-критерий 10/10 + 10/10

Контекст: дети 10–12, онлайн (Телемост), Игорь — рассказчик-импровизатор (определения на слайде,
не в его памяти), запрет спойлеров разгадки до слайда-кода, честность (KNN=альбом+похожие),
слайд = инфографика связей (Ильяхов), не текст для чтения. База: ответ Codex «содержательная линия»
(scratchpad/codex_slides_out.txt, скопирован в 02-codex-r0.md).
const checkui=$('#checkui'),zoneEl=$('#zone'),peek=$('#peek'),peekCtx=peek.getContext('2d');

// 2 КРУПНЫХ класса (image-KNN). zone — куда вести руку в раунде 1 (режиссируем dataset bias).
const CLASSES=[
  {emoji:'✋',name:'ладонь',color:'#7aa2ff', zone:{x:0.10,y:0.18,w:0.42,h:0.6}, zoneText:'СЛЕВА, ближе'},
  {emoji:'✊',name:'кулак', color:'#ffcf5c', zone:{x:0.48,y:0.30,w:0.40,h:0.52}, zoneText:'СПРАВА, дальше'}
];
let counts=[0,0]; const MINEX=5;          // лаборатория: минимум примеров на класс
const EMB_W=0.65, PIX_W=0.35;             // вес image-эмбеддинга vs сырых пикселей
const K_BIG=5, K_SMALL=3, NN_FAR=0.55;    // k и порог «непохоже/нет руки» (cos-расстояние)
let embedder=null, hander=null, state='intro', audio=null, camWasDown=false;
let provenTier=0, lastNN=1;

/* ==================== КОНФИГ УРОКА (переопределяется в URL) ==================== */
const QP=new URLSearchParams(location.search);
const CFG={
  // гейт размера: РАЗМЕР САМОЙ РУКИ (сторона bbox от hand-детектора, доля кадра 0..1).
  // ЛАДОНЬ учим только КРУПНО (side≥big), КУЛАК — только МЕЛКО (side≤small).
  // Детектор меряет именно кисть — тело/лицо/фон не мешают (фон-дифф на живых людях провалился: корпус качается).
  // Это единственная режиссура урока: она гарантирует, что ИИ выучит РАЗМЕР, а не жест
  // (предсказуемая поломка → ребёнок чинит данными). Гейт НЕ трогает признаки: KNN видит сырой квадрат
  // без scale-нормализации — НЕ вводить её, убьёт механику.
  // диапазоны: детектор ТЕРЯЕТ руку вплотную к камере (обрезанная рука не находится),
  // поэтому «крупно» имеет потолок — иначе ребёнка толкает в мёртвую зону (живой прогон 02.07)
  bigLo:+(QP.get('biglo')||0.40), bigHi:+(QP.get('bighi')||0.75),
  smLo:+(QP.get('smlo')||0.12),  smHi:+(QP.get('smhi')||0.28),   // 0.08→0.12 (смок 10.07): при 8% кадра
                                       // рука в 32×32 почти неразличима — мелкий кулак путался с мелкой ладонью
  fistLo:+(QP.get('fistlo')||0.28),    // «большой» порог ДЛЯ КУЛАКА мягче: кулак компактнее раскрытой
                                       // ладони, общий bigLo гнал руку вплотную — в слепую зону детектора (смок 09.07)
  needR1:6, needR2:3,                  // примеров на класс: раунд 1 (поломка) / раунд 2 (починка)
  gateHoldMs:600, sampleCdMs:900,      // гейт держится N мс → кадр пишется; кулдаун между кадрами
  wsCode:QP.get('code')||'33',         // код опроса — ведущий называет голосом в нужный момент
  revealCode:QP.get('rcode')||'4712',  // код разгадки — ДРУГОЙ и 4-значный: двузначный скучающий
                                       // ребёнок у экрана-замка подберёт перебором (плюс троттлинг ниже)
};
const WS=QP.has('ws');                 // режим воркшопа: номер места + кнопка опроса
const DBG=QP.has('debug');
const NOGATE=QP.has('nogate');         // страховка на занятии: гейты выключены, ведём голосом

/* ==================== ТЕЛЕМЕТРИЯ (только числа и текст опроса — НИКОГДА кадры/эмбеддинги) ==================== */
const TELE_URL='/tele';                // same-origin ручка на ws.meriler.cc (Aeza, ws-tele.service);
                                       // локально/оффлайн fetch тихо падает — данные остаются в localStorage
const TELE={
  sid:(Date.now().toString(36)+Math.random().toString(36).slice(2,7)),
  seat:null, t0:Date.now(), events:[], _saveT:0,
  push(type,data){ this.events.push({t:Date.now()-this.t0,type,...(data||{})});
    try{ if(typeof trySaveOn==='function')trySaveOn(type,data); }catch(e){}   // автосейв прогресса на вехах (F5, прогон 13.07)
    // 'seat'/'task_done' — ранняя регистрация (ребёнок виден серверу с первых минут); 'perf' пушится
    // раз в 30с в живых состояниях = heartbeat для дашборда (иначе на долгом сборе активный ребёнок
    // «краснеет» — аудит Codex 10.07); 'gate_stuck' — застрявший виден сразу;
    // 'boot_fail'/'cam_drop' — аварии видны немедленно (аудит 10.07: ребёнок с упавшей камерой был
    // невидимкой до pagehide); 'embed_fail' — немедленно только ПЕРВЫЙ (дальше и так в дампе вех)
    const imm=type==='seat'||type==='task_done'||type==='check_done'||type==='break_shown'||type==='final'||type==='survey_done'||type==='hypothesis'||type==='reveal_unlock'||type==='perf'||type==='gate_stuck'||type==='boot_fail'||type==='cam_drop'||(type==='embed_fail'&&!this._efImm&&(this._efImm=true));
    if(imm)this._saveT=0;                 // аварийное/веховое — мимо троттла _save: дамп не должен потеряться
    this._save(); if(imm)this.send(); },
  _save(){ const now=Date.now(); if(now-this._saveT<1500)return; this._saveT=now;
    try{ localStorage.setItem('tele_'+this.sid, JSON.stringify(this.dump())); }catch(e){} },
  dump(){ const ua=navigator.userAgent;
    // now: возраст последней активности считается сервером по ЭТИМ же часам (now − started − max(t)) —
    // дослойка старых дампов (resend) не выглядит на дашборде живой сессией (призраки 10.07)
    return {sid:this.sid,seat:this.seat,started:new Date(this.t0).toISOString(),now:Date.now(),
    os:/Windows/.test(ua)?'win':/Mac/.test(ua)?'mac':/Android/.test(ua)?'android':/iPhone|iPad/.test(ua)?'ios':/CrOS/.test(ua)?'chromeos':'other',
    mobile:/Mobi|Android|iPhone|iPad/.test(ua), gpu:window.__gpu||null,
    nogate:NOGATE, cfg:{bigLo:CFG.bigLo,bigHi:CFG.bigHi,smLo:CFG.smLo,smHi:CFG.smHi},
    demo:DEMO,ws:WS,events:this.events}; },
  send(beacon){ if(!TELE_URL)return; const body=JSON.stringify(this.dump());
    // fetch с keepalive на вехах (видим ответ), beacon — только на pagehide (переживает закрытие вкладки)
    try{ if(beacon){ navigator.sendBeacon(TELE_URL, body); }
      else fetch(TELE_URL,{method:'POST',body,keepalive:true}).catch(()=>{}); }catch(e){} },
  cleanup(){ // приватность: тексты детей не живут на устройстве вечно — TTL 7 дней (ревью terra 09.07)
    try{ for(const k of Object.keys(localStorage)){ if(!k.startsWith('tele_')||k==='tele_'+this.sid)continue;
      const d=JSON.parse(localStorage.getItem(k)); if(Date.now()-new Date(d.started)>7*864e5)localStorage.removeItem(k); } }catch(e){} },
  resend(){ // досылка недоставленного (ревью Codex 10.07): F5/обрыв сети не должны терять ребёнка целиком.
    // Все накопленные дампы шлём заново; чужой ключ удаляем ТОЛЬКО после подтверждённого 204 (сервер дедупит по sid)
    if(!TELE_URL)return;
    try{ for(const k of Object.keys(localStorage)){ if(!k.startsWith('tele_'))continue;
      const body=localStorage.getItem(k); if(!body)continue;
      fetch(TELE_URL,{method:'POST',body,keepalive:true})
        .then(r=>{ if(r.ok&&k!=='tele_'+this.sid)localStorage.removeItem(k); }).catch(()=>{});
    } }catch(e){} },
  download(){ // выгружаем ВСЕ сессии устройства (включая прерванные F5) — архив по ключам tele_*
    const all={current:this.dump(),sessions:{}};
    try{ for(const k of Object.keys(localStorage))if(k.startsWith('tele_'))all.sessions[k]=JSON.parse(localStorage.getItem(k)); }catch(e){}
    const b=new Blob([JSON.stringify(all,null,1)],{type:'application/json'});
    const a=document.createElement('a'); a.href=URL.createObjectURL(b);
    a.download='tele-'+(this.seat??'x')+'-'+this.sid+'.json'; a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),3000); }
};
// место из персональной ссылки известно ДО загрузки: boot_fail обязан прилетать с местом,
// иначе упавший ребёнок виден на дашборде как «без места» (аудит 10.07). Регистрация
// события seat{via:'link'} остаётся в enterGuide («дошёл до урока») — тут только идентификация.
{ const q=parseInt(QP.get('seat'),10); if(WS&&q>=1&&q<=99)TELE.seat=q; }
addEventListener('pagehide',()=>{ TELE._saveT=0; TELE._save(); TELE.send(true); });
addEventListener('online',()=>{ TELE.resend(); });   // сеть вернулась — досылаем всё накопленное

