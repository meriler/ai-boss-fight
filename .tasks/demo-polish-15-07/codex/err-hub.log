  1718	    showToast('Не смог прочитать сохранёнку —\nначнём заново 🙂',1600); startFirstTask(); return; }
  1719	  SAVE_CYCLE=s.cy||SAVE_CYCLE;   // «Продолжить» усыновляет цикл снимка (Codex R2)
  1720	  refresh(); updateHint();
  1721	  TELE.push('resume',{ms:s.ms});
