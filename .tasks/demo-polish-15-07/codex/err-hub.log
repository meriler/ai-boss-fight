   169	           ('проверка', 'card', ('break_shown', 'no_break', 'inconclusive')),
   170	           ('разбор', ('break_shown', 'no_break', 'inconclusive'), 'fix_start'),  # гипотеза+угадайка+замок+разгадка
   171	           ('починка', 'fix_start', 'final'),
   172	           ('опрос', 'final', 'survey_done')]
