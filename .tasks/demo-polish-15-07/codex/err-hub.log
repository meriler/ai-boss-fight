   118	def last_seen(d):
   119	    """Время последней РЕАЛЬНОЙ активности сессии, aware-datetime или None.
   120	
   121	    Не время приёма: досланный при resend старый дамп прилетает «сейчас», но его последняя
   122	    активность — в прошлом. Возраст считаем по клиентским часам (now − started − max(t)) —
   123	    одна пара часов, смещение времени на устройстве сокращается; recv — верхняя граница/fallback."""
   124	    recv = _parse_iso(d.get('_recv'))
   125	    if not recv:
   126	        return None
   127	    try:
   128	        started = _parse_iso(d.get('started'))
   129	        cnow = d.get('now')
   130	        if started and isinstance(cnow, (int, float)):
   131	            max_t = max((e.get('t', 0) for e in d.get('events', [])), default=0)
   132	            started_ms = started.timestamp() * 1000
   133	            stale_ms = max(0.0, float(cnow) - started_ms - max_t)  # возраст последнего события на момент отправки
   134	            return recv - timedelta(milliseconds=stale_ms)
   135	    except Exception:
   136	        pass
   137	    return recv
   138	
   139	
   140	def _ev_time(d, t_ms):
   141	    """Абсолютное время события с офсетом t_ms — та же пара клиентских часов, что в last_seen():
   142	    recv − (now − started − t). Нет now/started (старые дампы) → None."""
   143	    recv = _parse_iso(d.get('_recv'))
   144	    if not recv:
   145	        return None
   146	    try:
   147	        started = _parse_iso(d.get('started'))
   148	        cnow = d.get('now')
   149	        if started and isinstance(cnow, (int, float)) and isinstance(t_ms, (int, float)):
   150	            stale = max(0.0, float(cnow) - started.timestamp() * 1000 - float(t_ms))
   151	            return recv - timedelta(milliseconds=stale)
   152	    except Exception:
   153	        pass
   154	    return None
