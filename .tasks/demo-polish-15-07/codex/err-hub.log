  1535	function spawnSign(){ signs.push({cls:(Math.random()<0.5)?0:1,y:-0.14,charge:0,judged:false}); }
  1536	function tickGame(p,now){
  1537	  if(now<hitstopUntil)return; gameT++;
  1538	  const lbl=smoothLabel(), far=p?p.far:true, vote=p?(p.vote||0):0;
  1539	  if(warmup){ if(!signs.length)signs.push({cls:0,y:-0.14,charge:0,judged:false}); bigmsg.classList.remove('hidden');
  1540	    const s=signs[0]; bigmsg.innerHTML=`Покажи ${CLASSES[s.cls].emoji} ${CLASSES[s.cls].name}<br>и держи!`; s.y+=SIGN_VY*0.5;
  1541	    if(lbl===s.cls && !far) s.charge=Math.min(1,s.charge+0.05);
  1542	    if(s.charge>=1){warmup=false;bigmsg.classList.add('hidden');signs=[];spawnT=40;showToast('ПОЕХАЛИ! 💪',1000);hintEl.textContent='Покажи жест со знака и держи.';}
  1543	    return; }
  1544	  for(const s of signs){ s.y+=SIGN_VY; if(s.judged)continue;
  1545	    const inWin=s.y>=WIN_Y, correct=lbl===s.cls && !far;
  1546	    if(inWin&&correct){ s.charge=Math.min(1,s.charge+(vote>=0.99?0.055:0.038)*(1+provenTier*0.18)); }
  1547	    else if(s.charge>0){ s.charge=Math.max(0,s.charge-0.03); }
  1548	    if(s.charge>=1){ resolveSign(s,true,now,vote); continue; }
  1549	    if(s.y>=SIGN_IMPACT) resolveSign(s,false,now);
  1550	  }
  1551	  signs=signs.filter(s=>!(s.judged&&s.y>1.1));
  1552	  spawnT--; if(spawnT<=0 && signs.filter(s=>!s.judged).length===0){ spawnSign(); spawnT=Math.max(45,105-gameT/12); }
  1553	}
  1554	function resolveSign(s,ok,now,vote){
  1555	  s.judged=true; stats.total++; const ax=cv.width*0.5, ay=cv.height*SIGN_IMPACT;
  1556	  if(ok){ stats.hit++; combo++; const tier=vote>=0.99?2:1; score+=(10+tier*10)*(1+Math.floor(combo/5));
  1557	    effects.push({type:'wave',x:ax,y:ay,r:0,maxR:cv.width*(0.16+tier*0.06),life:1,c:CLASSES[s.cls].color});
  1558	    burst(ax,ay,12+tier*8,tier,CLASSES[s.cls].color);
  1559	    effects.push({type:'txt',x:ax,y:ay-cv.width*0.08,t:CLASSES[s.cls].emoji+' ✓'+(combo>=5?' x'+(1+Math.floor(combo/5)):''),c:NEON[0],life:1.1});
  1560	    SFX.hit2(); hitstopUntil=now+(tier>=2?150:90); shake=6+tier*3;   // вспышку убрали: мигание пугает (фидбек 02.07)
  1561	  } else { combo=0; lives--; SFX.miss(); shake=12; s.fail=true; const need=CLASSES[s.cls].emoji; let txt;
  1562	    const sl=smoothLabel();
  1563	    if(predCache&&predCache.far){txt='ИИ: непохоже · нужен '+need;stats.unsure++;}
  1564	    else if(sl!==s.cls&&sl>=0){txt='ИИ увидел '+CLASSES[sl].emoji+', а нужен '+need;stats.misread++;}
  1565	    else{txt='ИИ не уверен · нужен '+need;stats.unsure++;}
  1566	    effects.push({type:'txt',x:ax,y:ay-cv.width*0.07,t:txt,c:'#ff6b8b',life:1.5});
  1567	    if(lives<=0){endGame();return}
  1568	  }
  1569	}
