   647	/* ---- камера + модель ---- */
   648	function setLoad(m,r,pct){$('#loadmsg').textContent=m;$('#retry').classList.toggle('hidden',!r);
   649	  if(pct!=null){const b=$('#loadbar');b.style.width=pct+'%';
   650	    // внутри этапа полоска медленно ползёт к следующей вехе — видно, что живём
   651	    clearTimeout(setLoad._t); if(pct<100)setLoad._t=setTimeout(()=>{b.style.transition='width 6s linear';b.style.width=Math.min(pct+12,97)+'%';},120);
   652	    else b.style.transition='width .4s';}}
   653	async function initCamera(){ if(DEMO)return;
   654	  if(!navigator.mediaDevices?.getUserMedia)throw new Error('CAM:нет https/камеры');
   655	  if(initCamera._busy)return; initCamera._busy=true;    // авто-reconnect + кнопка не должны драться за камеру
   656	  try{
   657	    try{ cam.srcObject?.getTracks().forEach(t=>t.stop()); }catch(e){}   // старый поток гасим до нового запроса
   658	    let s;
   659	    // frameRate ограничен: слабые ноуты и так тянут embedder каждые 60мс — 30fps-видео им ни к чему
   660	    try{s=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'user'},width:{ideal:640},frameRate:{ideal:24,max:30}},audio:false})}
   661	    catch(e){ try{s=await navigator.mediaDevices.getUserMedia({video:true,audio:false})}catch(e2){throw new Error('CAM:'+e2.name)} }
   662	    cam.srcObject=s;await new Promise(r=>cam.onloadedmetadata=r);await cam.play().catch(()=>{});
   663	    // latch camWasDown: обрыв считаем ОДИН раз на инцидент — иначе ватчдог (интервал 2с) задублирует
   664	    // cam_drop от этого же обрыва (аудит Codex 10.07); сбрасывает latch ватчдог/камера-ретрай
   665	    s.getVideoTracks()[0].addEventListener('ended',()=>{if(!camWasDown){camWasDown=true;TELE.push('cam_drop',{auto:true});}hintEl.textContent='📷 камера отпала, перезапускаю…';initCamera().catch(()=>{})});
   666	  } finally { initCamera._busy=false; }
   667	}
   668	async function initModel(){
   669	  const vision=await FilesetResolver.forVisionTasks("./vendor/mediapipe/wasm");
   670	  const opt=d=>({baseOptions:{modelAssetPath:"./models/mobilenet_v3_small_embedder.tflite",delegate:d},runningMode:"IMAGE"});
   671	  try{ embedder=await ImageEmbedder.createFromOptions(vision,opt("GPU")); window.__gpu='GPU'; }
   672	  catch(e){ embedder=await ImageEmbedder.createFromOptions(vision,opt("CPU")); window.__gpu='CPU'; }
   673	  setLoad('Гружу ИИ… распознавание картинки',false,55);
   674	  const hopt=d=>({baseOptions:{modelAssetPath:"./models/hand_landmarker.task",delegate:d},runningMode:"IMAGE",numHands:1});
   675	  setLoad('Гружу ИИ… детектор руки',false,75);
   676	  try{ hander=await HandLandmarker.createFromOptions(vision,hopt(window.__gpu)); }
   677	  catch(e){ try{ hander=await HandLandmarker.createFromOptions(vision,hopt("CPU")); }
   678	    // на занятии без детектора урок невозможен (гейты не пройдут никогда) — честная ошибка на загрузке
   679	    // вместо молчаливого тупика на сборе (Codex R4). Дома/лаборатория без ws живут: сбор кнопками
   680	    catch(e2){ hander=null; if(WS)throw new Error('HAND:детектор руки не запустился'); } }
   681	}
   682	function resize(){cv.width=cam.videoWidth||window.innerWidth;cv.height=cam.videoHeight||window.innerHeight}
   683	
   684	/* ---- демо: синтетический кадр (без камеры), управляется window.__demo — для e2e-прогона ---- */
   685	const demoCv=document.createElement('canvas'); demoCv.width=224; demoCv.height=224; const dcx=demoCv.getContext('2d');
   686	window.__demo={cls:0,size:1.0,present:true};   // cls: 0 ладонь/1 кулак; size: 1=вплотную, 0.2=далеко
   687	function drawDemoFrame(){
   688	  const D=window.__demo;
   689	  dcx.fillStyle='#101a22'; dcx.fillRect(0,0,224,224);
   690	  // лёгкий стабильный шум фона (не рандом — чтобы фон-дифф был честным)
   691	  dcx.fillStyle='#33465a'; for(let i=0;i<6;i++)dcx.fillRect(20+i*34,170,18,40);
   692	  dcx.fillStyle='#223140'; dcx.fillRect(0,0,224,26);
   693	  if(!D.present)return;
   694	  const cx=112, cy=112, s=D.size;
   695	  dcx.fillStyle=D.cls===0?'#c9b8a8':'#c9a890';
   696	  if(D.cls===0){ // «ладонь»: 4 широких пальца + основание; s=1 заполняет большую часть кадра
   697	    for(let f=0;f<4;f++)dcx.fillRect(cx-52*s+f*28*s, cy-90*s, 22*s, 130*s);
   698	    dcx.fillRect(cx-60*s, cy+42*s, 130*s, 80*s);
   699	  } else {       // «кулак»: плотный круг; s=1 почти во весь кадр (как рука вплотную)
   700	    dcx.beginPath(); dcx.arc(cx,cy,95*s,0,7); dcx.fill();
   701	  }
   702	}
