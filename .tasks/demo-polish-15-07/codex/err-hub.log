   704	/* ---- классификация (отдельный цикл — embed дорог, не каждый rAF) ---- */
   705	let predCache=null, smooth=[];
   706	const LIVE_STATES=new Set(['train','check','game','train-pause','gteach','gcheck','gpause']);
   707	function classifyTick(){
   708	  if(LIVE_STATES.has(state) && (embedder) && (DEMO||cam.readyState>=2)){
   709	    const f=grabFeature(); curFeat=f;
   710	    const p=f?KNN.classify(f):null;
   711	    // temporal smoothing: majority за 5 замеров
   712	    if(p){ smooth.push(p.label); if(smooth.length>5)smooth.shift(); }
   713	    predCache=p;
   714	    drawPeek();
   715	    if(state==='gteach')tickGuidedTeach();
   716	    if(DBG)renderDebug(p);
   717	  }
   718	  setTimeout(classifyTick, 60);
   719	}
   720	let curFeat=null;
   721	function smoothLabel(){ if(!smooth.length)return -1; const c={};smooth.forEach(l=>c[l]=(c[l]||0)+1);let b=-1,bc=-1;for(const l in c)if(c[l]>bc){bc=c[l];b=+l}return b; }
   722	function drawPeek(){ if(!lastPix)return; const t=document.createElement('canvas');t.width=32;t.height=32;t.getContext('2d').putImageData(lastPix,0,0);
   723	  peekCtx.imageSmoothingEnabled=false; peekCtx.clearRect(0,0,32,32); peekCtx.drawImage(t,0,0); }
