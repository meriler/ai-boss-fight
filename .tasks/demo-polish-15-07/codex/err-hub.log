    97	        return f"не оценено ({fs.get('outcome')})"
    98	    cat = fs.get('guessCat'); chosen = fs.get('fixChosen')
    99	    partial = any(f.get('attempt') == 2 and f.get('correct') for f in fixes)
   100	    did = chosen == 'self'
   101	    said = cat in ('data-right', 'data-generic', 'specific-wrong')
   102	    mark = '±' if (did and partial) else ''
   103	    if did and said: return f'Понял{mark} (предв.)'
   104	    if did: return f'Сделал, но не понял{mark} (предв.)'
   105	    if said: return 'Сказал, но не сделал (предв.)'
