   209	def _boot_dead(sessions, raw_recv):
   210	    """Последняя ПРИНЯТАЯ сессия места упала на загрузке и не поднялась (boot_fail без
   211	    последующего boot_ok). Retry с успехом в той же/новой сессии снимает флаг (Codex 10.07)."""
