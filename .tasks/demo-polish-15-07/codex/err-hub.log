   628	function refresh(){
   629	  [...teachrow.children].forEach((el,i)=>{
   630	    el.querySelector('.c b').textContent=counts[i];
   631	    el.querySelector('.del').disabled=!counts[i];
   632	    el.querySelector('.h').textContent = 'держи в рамке';
   633	  });
   634	  const mn=Math.min(counts[0],counts[1]),mx=Math.max(counts[0],counts[1]);
   635	  let warn=''; if(mx>=4 && mx>=mn*2+2){const less=counts[0]<counts[1]?0:1;warn=` · <span class="cw">⚠️ перекос — добери ${CLASSES[less].emoji}</span>`;}
   636	  $('#counts').innerHTML=`данные ИИ: ${CLASSES[0].emoji} <b>${counts[0]}</b> · ${CLASSES[1].emoji} <b>${counts[1]}</b>${warn}`;
   637	  toCheckBtn.disabled=!(counts[0]>=MINEX&&counts[1]>=MINEX);
   638	  $('#toGame').disabled=toCheckBtn.disabled;   // игра — только с обученной моделью
   639	  try{$('#toGallery').disabled=!(counts[0]+counts[1]);}catch(e){}   // галерея — как только есть хоть один пример
