    state='gpause'; stepCard({big:'🔧',title:'С возвращением!',text:'Твои примеры целы. Проверим починку ещё раз?',btn:'🔍 Проверить',onGo:()=>startGuidedCheck(2)}); }
  else if(s.ms==='revealed'){ showRevealScreen(); }
