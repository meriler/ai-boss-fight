function saveKey(){ return WS ? ('ws_save_'+(TELE.seat??'x')) : null; }
function _b64(buf){ const u=buf.buffer?new Uint8Array(buf.buffer,buf.byteOffset||0,buf.byteLength):new Uint8Array(buf); let s=''; for(let i=0;i<u.length;i+=4096)s+=String.fromCharCode.apply(null,u.subarray(i,i+4096)); return btoa(s); }
function _unb64(s){ const b=atob(s),u=new Uint8Array(b.length); for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i); return u; }
const SAVE_RANK={r1:1,checked1:2,revealed:3,fixdata:4,final:5};
/* Цикл сейва (Codex R2 14.07): «Поехали» рождает новый cycleId, «Продолжить» усыновляет id снимка.
   Ранг-защита вех действует только ВНУТРИ цикла; слот с чужим cy (вторая вкладка того же места)
   не перезаписывается — чужой final не приезжает поверх свежего r1. SAVE_FRESH гаснет только после
   ПОДТВЕРЖДЁННОЙ записи: неудачная первая запись не возвращает старый ранг в силу. */
let SAVE_FRESH=false, SAVE_CYCLE=null;
function _tsOk(ts){ const age=Date.now()-ts; return Number.isFinite(ts)&&age>-60e3&&age<6*3600e3; }
function saveMilestone(ms){ const key=saveKey(); if(!key||!KNN.ex.length)return; try{
  if(!SAVE_CYCLE)SAVE_CYCLE=Math.random().toString(36).slice(2,10);
  const prev=loadSave();
  if(!SAVE_FRESH&&prev){
    if(prev.cy&&prev.cy!==SAVE_CYCLE)return;               // слот занят другим циклом (другая вкладка) — не трогаем
    if(SAVE_RANK[prev.ms]>SAVE_RANK[ms])ms=prev.ms;        // внутри цикла веха не откатывается (повторная проверка R1)
  }
  const body=JSON.stringify({v:1, cy:SAVE_CYCLE, ts:Date.now(), ms,
    ex:KNN.ex.map(x=>({e:_b64(x.emb),p:_b64(x.pix),l:x.l})),
    counts:[counts[0],counts[1]],
    th:[THUMBS[0],THUMBS[1]].map(a=>a.map(x=>({d:_b64(x.img.data),r:x.round}))),
    g:{res1:GUIDE.res1,res2:GUIDE.res2,guessKey:GUIDE.guessKey,guessCat:GUIDE.guessCat,
       fixChosen:GUIDE.fixChosen,fixTries:GUIDE.fixTries,outcome:GUIDE.outcome}});
  let wrote=false;
  try{ localStorage.setItem(key,body); wrote=true; }
  catch(err){ // ТОЛЬКО при квоте: выкинуть достоверно протухшие v1-сейвы и попробовать ровно ещё раз
    const q=err&&(err.name==='QuotaExceededError'||err.code===22||/quota/i.test(String(err)));
    if(q)try{ for(const k of Object.keys(localStorage)){ if(!k.startsWith('ws_save_')||k===key)continue;
        let dead=false; try{ const d=JSON.parse(localStorage.getItem(k)); dead=!!d&&d.v===1&&!_tsOk(d.ts); }catch(_){}
        if(dead)localStorage.removeItem(k); }
      localStorage.setItem(key,body); wrote=true; }catch(_){}
  }
  if(wrote)SAVE_FRESH=false;   // флаг «новый цикл» живёт до первой УСПЕШНОЙ записи (Codex R2)
}catch(e){} }
function loadSave(){ const key=saveKey(); if(!key)return null; try{
  const s=JSON.parse(localStorage.getItem(key)||'null');
  if(!s||s.v!==1||!Array.isArray(s.ex)||!s.ex.length||!s.g||!Array.isArray(s.counts))return null;
  if(!_tsOk(s.ts))return null;   // NaN/строка/будущее — не проходят
  return s; }catch(e){ return null; } }
function clearSave(){ const key=saveKey(); if(key)try{localStorage.removeItem(key)}catch(e){} }
function applySave(s){
  // транзакционность (Codex R2): сначала декодируем и проверяем ВСЁ во временные массивы,
  // мутируем runtime только целиком — битый хвост снимка не оставляет полу-применённую модель
  const ex=[], th=[[],[]];
  s.ex.forEach(x=>{ const eb=_unb64(x.e),pb=_unb64(x.p);
    if(!eb.length||eb.length%4||!pb.length||pb.length%4)throw new Error('bad save ex');
    if(!(x.l===0||x.l===1))throw new Error('bad save label');
    ex.push({emb:new Float32Array(eb.buffer), pix:new Float32Array(pb.buffer), l:x.l}); });
  const el0=ex[0].emb.length, pl0=ex[0].pix.length;
  if(ex.some(x=>x.emb.length!==el0||x.pix.length!==pl0))throw new Error('bad save dims');
  if(!Array.isArray(s.th)||s.th.length!==2)throw new Error('bad save th');
  s.th.forEach((a,c)=>a.forEach(x=>{ const d=_unb64(x.d);
    if(d.length!==4096)throw new Error('bad save thumb');   // строго 32×32×4
    th[c].push({img:new ImageData(new Uint8ClampedArray(d.buffer),32,32),round:x.r}); }));
  const c0=s.counts[0]|0, c1=s.counts[1]|0;
  if(c0<0||c1<0)throw new Error('bad save counts');
  // --- всё проверено, применяем атомарно ---
  KNN.clear(); ex.forEach(x=>KNN.ex.push(x));
  counts[0]=c0; counts[1]=c1;
  THUMBS[0].length=0; THUMBS[1].length=0;
  th.forEach((a,c)=>a.forEach(x=>THUMBS[c].push(x)));
  Object.assign(GUIDE,{res1:s.g.res1,res2:s.g.res2,guessKey:s.g.guessKey,guessCat:s.g.guessCat,
    fixChosen:s.g.fixChosen,fixTries:s.g.fixTries||0,outcome:s.g.outcome});
