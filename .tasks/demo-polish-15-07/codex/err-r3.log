    d.innerHTML='<div id="dbtext"></div><div class="dbtns"><button class="ghost" id="dbTele">💾 телеметрия</button></div>';
    $('#dbTele').onclick=()=>TELE.download();
    dbText=$('#dbtext'); }
  const hand=lastHand.ok?('side '+lastHand.side.toFixed(2)):'нет руки';
  const T=GUIDE.task, gate=T?T.gate:(state==='gcheck'&&CHK?CHK.cards[CHK.idx]?.gate:null);
  let knn='';
  if(p&&p.top){ knn=p.top.map(t=>`  ${CLASSES[t.l].emoji} emb:${t.ed.toFixed(2)} pix:${t.pd.toFixed(2)} → ${(EMB_W*t.ed+PIX_W*t.pd).toFixed(2)}`).join('\n');
    knn=`\nKNN top-${p.top.length} (label:${p.label!=null?CLASSES[p.label].emoji:'—'} vote:${(p.vote*100)|0}%)\n`+knn; }
  dbText.innerHTML=`<b>state</b> ${state}  <b>рука</b> ${hand}${gate?`  <b>gate:${gate}</b> ${gateOk(gate)?'✅':'✋'}`:''}
<b>пороги</b> big ${CFG.bigLo}–${CFG.bigHi} · small ${CFG.smLo}–${CFG.smHi}  <b>детектор</b> ${hander?'ok':'НЕТ'}
<b>примеры</b> ✋${counts[0]} ✊${counts[1]}${knn}`;
}
/* pointer-сбор — общий реестр с клавишами: stopCollect() гасит ОБА канала (reset/blur/смена класса — Codex R2 п.13) */
let _ptrHold={t:null,el:null};
function stopPtrHold(){ if(_ptrHold.t)clearInterval(_ptrHold.t);
  if(_ptrHold.el)_ptrHold.el.classList.remove('rec');
  _ptrHold={t:null,el:null}; if(_keyHold.cls<0)recCls=-1; }
function stopCollect(){ stopKeyHold(); stopPtrHold(); }
function bindHold(){[...teachrow.children].forEach(el=>{const i=+el.dataset.i;
  const del=el.querySelector('.del');
  del.addEventListener('pointerdown',e=>{e.stopPropagation();e.preventDefault();if(state!=='train')return;if(KNN.delLast(i)){counts[i]=Math.max(0,counts[i]-1);THUMBS[i].pop();TELE.push('sample_del',{cls:i});refresh();updateHint();SFX.buzz();}});
  const dn=e=>{if(e.target.closest('.del'))return;e.preventDefault();if(state!=='train')return;stopCollect();el.classList.add('rec');recCls=i;addExample(i);
    _ptrHold={el,t:setInterval(()=>{ if(state!=='train'){stopPtrHold();return;} addExample(i); },450)}};
  const up=()=>stopPtrHold();
  el.addEventListener('pointerdown',dn);el.addEventListener('pointerup',up);el.addEventListener('pointercancel',up);el.addEventListener('pointerleave',up)})}
/* Клавиши 1/2: собирать примеры, не отрывая руку от жеста (прогон 13.07: «руки накрест» —
   мышь на кнопке + жест в камеру одновременно неудобно). Держишь клавишу — идёт сбор. */
let _keyHold={t:null,cls:-1};
function stopKeyHold(){ if(_keyHold.t)clearInterval(_keyHold.t);
  if(_keyHold.cls>=0){ const el=teachrow.children[_keyHold.cls]; if(el)el.classList.remove('rec'); recCls=-1; }
  _keyHold={t:null,cls:-1}; }
window.addEventListener('keydown',e=>{
  if(state!=='train'||e.repeat)return;
  const cls=e.key==='1'?0:e.key==='2'?1:-1;
  if(cls<0||_keyHold.cls===cls)return;
  if(e.target&&/INPUT|TEXTAREA/.test(e.target.tagName))return;
  stopCollect();   // переключение 1↔2 и клавиша поверх зажатого pointer: старый сбор гаснет целиком
  _keyHold={cls,t:setInterval(()=>{ if(state!=='train'){stopKeyHold();return;} addExample(cls); },450)};
  const el=teachrow.children[cls]; if(el)el.classList.add('rec'); recCls=cls;
  addExample(cls);
});
window.addEventListener('keyup',e=>{
  const cls=e.key==='1'?0:e.key==='2'?1:-1;
  if(cls<0||_keyHold.cls!==cls)return;
  stopKeyHold();
});
window.addEventListener('blur',stopCollect);   // Cmd+Tab/клик в звонок уносит keyup/pointerup мимо страницы — сбор не должен продолжаться (ревью 14.07)
document.addEventListener('visibilitychange',()=>{ if(document.hidden)stopCollect(); });
window.addEventListener('resize',resize);
if(DEMO)$('.badge').textContent='демо: без камеры, кадр синтетический';
</script>
</body>
