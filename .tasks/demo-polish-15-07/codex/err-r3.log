   161	def load_session(date):
   162	    """Окно занятия из session-<date>.json: (start, stop, auto). Старт без стопа старше 2 часов
   163	    считается закрытым в start+2ч (автофиниш) — «забыли нажать ⏹» не растягивает отчёт на весь день."""
   164	    try:
   165	        with open(os.path.join(DIR, 'session-' + date + '.json'), encoding='utf-8') as f:
   166	            s = json.load(f)
   167	        def _p(v):
   168	            return datetime.strptime(v, '%Y-%m-%dT%H:%M:%S').replace(tzinfo=MSK) if v else None
   169	        start, stop, auto = _p(s.get('start')), _p(s.get('stop')), False
   170	        if start and not stop and datetime.now(MSK) - start > timedelta(hours=2):
   171	            stop, auto = start + timedelta(hours=2), True
   172	        return start, stop, auto
   173	    except Exception:
   174	        return None, None, False
